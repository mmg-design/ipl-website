---
/** Author avatar, name, date and read time. Initials stand in until a headshot is uploaded in Sanity. */
import { formatDate, initials, type Author } from "@/data/posts";
interface Props { author?: Author; date?: string; readTime?: number; class?: string }
const { author, date, readTime, class: className } = Astro.props;
const name = author?.name ?? "IPL Staff";
---

<span class:list={["author-chip", className]}>
  {author?.photo ? <img class="author-chip_avatar" src={author.photo} alt="" loading="lazy" /> : <span class="author-chip_avatar is-initials" aria-hidden="true">{initials(name)}</span>}
  <span class="author-chip_text">
    <span class="author-chip_name">{name}</span>
    <span class="author-chip_meta">
      {date && <time datetime={date}>{formatDate(date)}</time>}
      {date && readTime && <span aria-hidden="true">·</span>}
      {readTime && <span>{readTime} min read</span>}
    </span>
  </span>
</span>

<style is:global>
  @layer components {
    .author-chip { display: inline-flex; align-items: center; gap: 0.75rem; }
    .author-chip_avatar { width: 2.5rem; height: 2.5rem; border-radius: 50%; object-fit: cover; flex: none; }
    .author-chip_avatar.is-initials {
      display: grid; place-items: center; font-size: 0.8125rem; font-weight: var(--primary-bold); letter-spacing: 0.04em;
      color: #fff; background: linear-gradient(#ffffff22, #ffffff00), var(--brand-500);
    }
    .author-chip_text { display: flex; flex-direction: column; gap: 0.125rem; line-height: 1.35; }
    .author-chip_name { font-size: 0.9375rem; font-weight: var(--primary-bold); }
    .author-chip_meta { display: flex; gap: 0.5rem; font-size: 0.875rem; opacity: 0.75; }
  }
</style>
