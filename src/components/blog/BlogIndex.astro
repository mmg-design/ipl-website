---
/** Blog listing (Figma Blog 21): page intro, featured post, category filter, two-up grid. */
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import AuthorChip from "@/components/blog/AuthorChip.astro";
import { categoryOrder, type Post } from "@/data/posts";

interface Props { eyebrow: string; title: string; text: string; posts: Post[] }
const { eyebrow, title, text, posts } = Astro.props;

const featured = posts.find((p) => p.featured) ?? posts[0];
const rest = posts.filter((p) => p !== featured);
const rank = (c: string) => { const i = categoryOrder.indexOf(c); return i === -1 ? 99 : i; };
const categories = [...new Set(rest.map((p) => p.category).filter(Boolean))].sort((a, b) => rank(a) - rank(b));
---

<div class="blog-index">
  <div class="blog-index_intro">
    <Eyebrow>{eyebrow}</Eyebrow>
    <Heading tag="h1" variant="h1">{title}</Heading>
    <Paragraph>{text}</Paragraph>
  </div>

  {featured && (
    <a class="blog-featured" href={`/blog/${featured.slug}`}>
      <span class="blog-featured_media"><img src={featured.image} alt={featured.imageAlt} /></span>
      <span class="blog-featured_body">
        <span class="blog-pill">{featured.category}</span>
        <span class="blog-featured_title">{featured.title}</span>
        <span class="blog-featured_excerpt">{featured.excerpt}</span>
        <AuthorChip author={featured.author} date={featured.publishedAt} readTime={featured.readTime} />
      </span>
    </a>
  )}

  {rest.length > 0 && (
    <div class="blog-index_list" data-blog-filter>
      <div class="blog-toolbar">
        {categories.length > 1 ? (
          <div class="blog-filter" role="group" aria-label="Filter posts by category">
            <button type="button" class="blog-filter_btn is-active" data-filter="all" aria-pressed="true">View all posts</button>
            {categories.map((c) => <button type="button" class="blog-filter_btn" data-filter={c} aria-pressed="false">{c}</button>)}
          </div>
        ) : <span />}
        <label class="blog-search">
          <span class="sr-only">Search posts</span>
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.8" /><path d="M13.5 13.5L17 17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
          <input type="search" placeholder="Search posts" autocomplete="off" data-blog-search />
        </label>
      </div>
      <ul class="blog-grid" role="list">
        {[featured, ...rest].map((post, i) => (
          <li data-category={post.category} data-search={`${post.title} ${post.excerpt} ${post.category}`.toLowerCase()} data-featured={i === 0 ? "" : undefined} hidden={i === 0}>
            <a class="blog-card" href={`/blog/${post.slug}`}>
              <span class="blog-card_media"><img src={post.image} alt={post.imageAlt} loading="lazy" /></span>
              <span class="blog-pill">{post.category}</span>
              <span class="blog-card_title">{post.title}</span>
              <span class="blog-card_excerpt">{post.excerpt}</span>
              <AuthorChip author={post.author} date={post.publishedAt} readTime={post.readTime} />
            </a>
          </li>
        ))}
      </ul>
      <p class="blog-grid_empty" hidden>No posts match that yet. Try another word or category.</p>
    </div>
  )}
</div>

<script>
  /* Category buttons and search work together. The featured post only joins
     the grid while searching, so it can be found but is not shown twice. */
  document.querySelectorAll<HTMLElement>("[data-blog-filter]").forEach((root) => {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>(".blog-filter_btn")];
    const items = [...root.querySelectorAll<HTMLElement>("[data-category]")];
    const empty = root.querySelector<HTMLElement>(".blog-grid_empty");
    const search = root.querySelector<HTMLInputElement>("[data-blog-search]");
    let category = "all";
    const apply = () => {
      const q = (search?.value ?? "").trim().toLowerCase();
      const words = q.split(/\s+/).filter(Boolean);
      let shown = 0;
      items.forEach((li) => {
        const inCategory = category === "all" || li.dataset.category === category;
        const matches = words.every((w) => (li.dataset.search ?? "").includes(w));
        const featuredOk = !("featured" in li.dataset) || words.length > 0 || category !== "all";
        const show = inCategory && matches && featuredOk;
        li.hidden = !show;
        if (show) shown++;
      });
      if (empty) empty.hidden = shown > 0;
    };
    buttons.forEach((btn) => btn.addEventListener("click", () => {
      category = btn.dataset.filter ?? "all";
      buttons.forEach((b) => { const on = b === btn; b.classList.toggle("is-active", on); b.setAttribute("aria-pressed", String(on)); });
      apply();
    }));
    search?.addEventListener("input", apply);
  });
</script>

<style is:global>
  @layer components {
    .blog-index { display: flex; flex-direction: column; gap: var(--space-8); width: 100%; padding-top: 9rem; }
    .blog-index_intro { display: flex; flex-direction: column; align-items: flex-start; gap: 1.5rem; max-width: 44rem; }
    .blog-index_intro > * { margin: 0 !important; }
    .blog-index_intro .heading + .text { margin-top: 0.75rem !important; }
    .blog-pill {
      display: inline-flex; align-items: center; justify-content: center; font-size: 0.8125rem; font-weight: var(--primary-bold); letter-spacing: 0.06em; text-transform: uppercase; line-height: 1;
      text-box: trim-both cap alphabetic; padding: 0.5rem 0.875rem; border-radius: 999px; color: #fff; background: var(--brand-500); border: 1px solid rgb(255 255 255 / 0.28);
    }
    .blog-featured { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); align-items: center; gap: var(--space-8); color: inherit; text-decoration: none; }
    .blog-featured_media, .blog-card_media { display: block; overflow: hidden; border-radius: 0.75rem; background: rgb(255 255 255 / 0.04); }
    .blog-featured_media img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; transition: scale 0.5s cubic-bezier(0.2, 0.7, 0.2, 1); }
    .blog-featured_body { display: flex; flex-direction: column; align-items: flex-start; gap: 1.25rem; }
    .blog-featured_title { font-size: clamp(1.625rem, 2.6vw, 2.25rem); font-weight: var(--primary-bold); line-height: 1.15; letter-spacing: -0.01em; transition: color 0.3s; }
    .blog-featured_excerpt { font-size: 1.0625rem; line-height: 1.65; opacity: 0.85; }
    .blog-featured:hover .blog-featured_media img, .blog-card:hover .blog-card_media img { scale: 1.03; }
    .blog-featured:hover .blog-featured_title, .blog-card:hover .blog-card_title { color: var(--brand-500); }

    .blog-index_list { display: flex; flex-direction: column; gap: var(--space-7); border-top: 1px solid rgb(255 255 255 / 0.1); padding-top: var(--space-7); }
    .blog-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 1rem 2rem; flex-wrap: wrap; }
    .blog-filter { display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .blog-search {
      position: relative; display: flex; align-items: center; width: min(100%, 18rem); margin-left: auto;
    }
    .blog-search svg { position: absolute; left: 0.875rem; width: 1.125rem; height: 1.125rem; opacity: 0.6; pointer-events: none; }
    .blog-search input {
      width: 100%; font: inherit; font-size: 0.9375rem; color: inherit;
      padding: 0.6875rem 1rem 0.6875rem 2.625rem; border-radius: 0.5rem;
      background: rgb(0 0 0 / 0.22); border: 1px solid rgb(255 255 255 / 0.16);
      box-shadow: inset 0 2px 4px rgb(0 0 0 / 0.25); transition: border-color 0.2s, background-color 0.2s;
    }
    .blog-search input::placeholder { color: rgb(255 255 255 / 0.55); }
    .blog-search input:hover { border-color: rgb(255 255 255 / 0.28); }
    .blog-search input:focus-visible { outline: 2px solid var(--brand-500); outline-offset: 1px; border-color: transparent; }
    .blog-grid_empty { margin: 0; opacity: 0.75; }
    .blog-filter_btn {
      font: inherit; font-size: 0.9375rem; font-weight: var(--primary-bold); color: inherit; cursor: pointer;
      padding: 0.625rem 1.125rem; border-radius: 0.5rem; background: transparent; border: 1px solid transparent;
      transition: background-color 0.25s, border-color 0.25s;
    }
    .blog-filter_btn:hover { background: rgb(255 255 255 / 0.06); }
    .blog-filter_btn.is-active { background: rgb(255 255 255 / 0.08); border-color: rgb(255 255 255 / 0.3); }
    .blog-filter_btn:focus-visible { outline: 2px solid var(--brand-500); outline-offset: 2px; }
    .blog-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-8) 2.5rem; }
    .blog-grid > li[hidden] { display: none; }
    .blog-card { display: flex; flex-direction: column; align-items: flex-start; gap: 1.125rem; color: inherit; text-decoration: none; }
    .blog-card_media { width: 100%; }
    .blog-card_media img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; transition: scale 0.5s cubic-bezier(0.2, 0.7, 0.2, 1); }
    .blog-card_title { font-size: 1.25rem; font-weight: var(--primary-bold); line-height: 1.3; transition: color 0.3s; }
    .blog-card_excerpt { font-size: 1.0625rem; line-height: 1.65; opacity: 0.85; }
    .blog-featured:focus-visible, .blog-card:focus-visible { outline: 2px solid var(--brand-500); outline-offset: 0.5rem; border-radius: 0.75rem; }
    @media (width < 64rem) {
      .blog-search { width: 100%; margin-left: 0; }
      .blog-index { padding-top: 8rem; }
      .blog-featured { grid-template-columns: 1fr; gap: 1.5rem; }
      .blog-grid { grid-template-columns: 1fr; }
    }
  }
</style>
