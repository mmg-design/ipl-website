---
/** Post body (Figma Content 31): article on the left, sticky aside on the right. */
import { toHTML, type PTNode } from "@/lib/sanity/portableText";
interface Props { body?: PTNode[] }
const { body = [] } = Astro.props;
const html = toHTML(body);
---

<div class="post-body">
  <article class="post-body_article" set:html={html} />
  <aside class="post-body_aside"><slot name="aside" /></aside>
</div>

<style is:global>
  @layer components {
    .post-body { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 20rem); gap: var(--space-8); align-items: start; width: 100%; }
    .post-body_article { max-width: 46rem; font-size: 1.0625rem; line-height: 1.75; }
    .post-body_article :where(h2, h3, h4, p, ul, ol, li, blockquote, figure, figcaption) { margin: 0; text-box: normal; }
    .post-body_article > * + * { margin-top: 1.25rem; }
    .post-body_article > :is(h2, h3, h4) { margin-top: 2.75rem; }
    .post-body_article > :is(h2, h3, h4) + * { margin-top: 0.875rem; }
    .post-body_article > :is(figure, blockquote), .post-body_article > :is(figure, blockquote) + * { margin-top: 2.25rem; }
    .post-body_article :is(ul, ol) { padding-left: 1.5em; }
    .post-body_article ul { list-style: disc; }
    .post-body_article ol { list-style: decimal; }
    .post-body_article li::marker { color: var(--brand-500); }
    .post-body_article :is(h2, h3, h4) { line-height: 1.2; letter-spacing: -0.01em; }
    .post-body_article h2 { font-size: clamp(1.5rem, 2.4vw, 2rem); }
    .post-body_article h3 { font-size: 1.375rem; }
    .post-body_article h4 { font-size: 1.125rem; }
    .post-body_article p.is-lead { font-weight: var(--primary-bold); font-size: 1.125rem; line-height: 1.65; }
    .post-body_article a { color: var(--brand-500); text-decoration: underline; text-underline-offset: 0.2em; }
    .post-body_article blockquote { padding-left: 1.5rem; border-left: 3px solid var(--brand-500); font-size: 1.25rem; line-height: 1.55; font-style: italic; }
    .post-body_article figure img { width: 100%; border-radius: 0.75rem; }
    .post-body_article figcaption { margin-top: 0.75rem; font-size: 0.875rem; opacity: 0.7; padding-left: 0.75rem; border-left: 2px solid rgb(255 255 255 / 0.25); }
    .post-body_article li + li { margin-top: 0.5rem; }
    .post-body_aside { position: sticky; top: 7rem; }
    @media (width < 64rem) {
      .post-body { grid-template-columns: 1fr; }
      .post-body_aside { position: static; }
    }
  }
</style>
