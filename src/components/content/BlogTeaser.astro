---
/** "The IPL Blog" section: latest 3 posts from Sanity (or fallback). */
import SectionIntro from "@/components/content/SectionIntro.astro";
import Button from "@/components/Button.astro";
import { getPosts } from "@/data/posts";

interface Props {
  /** Prefer posts tagged for this page in Sanity (relatedPages). */
  page?: string;
  heading?: string;
  text?: string;
}
const {
  page = "",
  heading = "Expert-backed baseball and softball content",
  text = "The same questions come up every week, so our coaches wrote the answers down. Real numbers out of our own cages, and no sales pitch attached.",
} = Astro.props;
const posts = await getPosts({ limit: 3, page });
---

<div class="blog-teaser_wrap">
  <div class="blog-teaser_header">
    <SectionIntro eyebrow="The IPL Blog" heading={heading} text={text} align="start" id="blog-title" />
    <Button element="link" href="/blog" emphasis="secondary">View all posts</Button>
  </div>
  <ul class="blog-teaser_list" role="list">
    {posts.map((post) => (
      <li class="blog-teaser_card">
        <a class="blog-teaser_link" href={`/blog/${post.slug}`}>
          <img class="blog-teaser_image" src={post.image} alt={post.imageAlt} loading="lazy" />
          <span class="blog-teaser_meta">
            <span class="blog-teaser_pill">{post.category}</span>
            <span class="blog-teaser_time">{post.readTime} min read</span>
          </span>
          <h3 class="blog-teaser_title">{post.title}</h3>
          <p class="blog-teaser_excerpt">{post.excerpt}</p>
          <span class="blog-teaser_more" aria-hidden="true">
            Read more
            <svg viewBox="0 0 16 16" fill="none"><path d="M6 3.5L10.5 8 6 12.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </span>
        </a>
      </li>
    ))}
  </ul>
</div>

<style is:global>
  @layer components {
    .blog-teaser_wrap { display: flex; flex-direction: column; gap: var(--space-8); width: 100%; }
    .blog-teaser_header { display: flex; align-items: flex-end; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
    .blog-teaser_header .section-intro { max-width: 48rem; }
    .blog-teaser_list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; }
    .blog-teaser_link { display: flex; flex-direction: column; align-items: flex-start; gap: 1.25rem; color: inherit; text-decoration: none; }
    .blog-teaser_link > * { margin: 0; }
    .blog-teaser_image { width: 100%; aspect-ratio: 405 / 270; object-fit: cover; border-radius: 0.5rem; transition: scale 0.4s ease; }
    .blog-teaser_link:hover .blog-teaser_image { scale: 1.02; }
    .blog-teaser_meta { display: flex; align-items: center; gap: 1rem; margin-top: 0.25rem !important; }
    .blog-teaser_pill {
      font-size: 0.875rem; font-weight: var(--primary-bold); letter-spacing: 0.06em; text-transform: uppercase; line-height: 1.3;
      padding: 0.375rem 0.875rem; border-radius: 999px; color: white;
      background: var(--brand-500); border: 1px solid rgb(255 255 255 / 0.28);
    }
    .blog-teaser_time { font-size: 0.875rem; font-weight: var(--primary-bold); }
    .blog-teaser_title { font-size: 1.125rem; font-weight: var(--primary-bold); line-height: 1.3; transition: color 0.3s ease; }
    .blog-teaser_excerpt { font-size: 1.0625rem; line-height: 1.65; }
    .blog-teaser_more { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 1.0625rem; margin-top: 0.5rem !important; transition: color 0.3s ease; }
    .blog-teaser_more svg { width: 1rem; height: 1rem; transition: translate 0.3s ease; }
    .blog-teaser_link:hover :is(.blog-teaser_title, .blog-teaser_more) { color: var(--brand-500); }
    .blog-teaser_link:hover .blog-teaser_more svg { translate: 0.25rem 0; }
    .blog-teaser_link:focus-visible { outline: 0.125rem solid var(--brand-500); outline-offset: 0.5rem; border-radius: 0.5rem; }
    @media (width < 64rem) { .blog-teaser_list { grid-template-columns: 1fr; max-width: 32rem; } }
  }
</style>
