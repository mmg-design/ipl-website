---
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Button from "@/components/Button.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import { booking } from "@/data/home";

interface Props {
  render?: boolean;
  class?: string;
}
const { render = true, class: className } = Astro.props;

const stats = [
  { value: "6", label: "Wide tunnels, HitTrax in all of them" },
  { value: "800+", label: "Athletes trained" },
  { value: "4", label: "Programs under one roof: IPL, 2SP, HP, Champion Mindset" },
  { value: "13+", label: "Big league seasons behind the instruction" },
];
---

{
  render && (
    <div class:list={["building-stats_wrap", className]}>
      <div class="building-stats_content">
        <Eyebrow>The building</Eyebrow>
        <Heading id="building-title">Michigan’s premier baseball and softball training HQ.</Heading>
        <Paragraph class="max-width-none">
          Most baseball and softball training facilities lack robustness and aren't specified. We proudly serve baseball and softball athletes end to end and have deeply thought through everything these sports desire.
        </Paragraph>
        <ButtonWrapper>
          <Button element="link" href={booking}>Book a tour</Button>
          <Button element="link" href="/#facility" emphasis="secondary">See the cages</Button>
        </ButtonWrapper>
      </div>
      <dl class="building-stats_grid">
        {stats.map((stat) => (
          <div class="building-stats_item">
            <dt class="building-stats_value">{stat.value}</dt>
            <dd class="building-stats_label">{stat.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  )
}

<style is:global>
  @layer components {
    .building-stats_wrap {
      display: grid;
      grid-template-columns: 38.5rem 1fr;
      align-items: center;
      gap: var(--space-8);
      width: 100%;
    }
    .building-stats_content { display: flex; flex-direction: column; align-items: flex-start; }
    .building-stats_content .eyebrow_wrap { margin-bottom: 1rem; }
    .building-stats_content .heading { margin: 0 0 1.5rem; }
    .building-stats_content .text { margin: 0 0 2rem; }
    .building-stats_grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem 2rem;
      margin: 0;
    }
    .building-stats_item { display: flex; flex-direction: column; gap: 1rem; padding-left: 2rem; }
    .building-stats_value {
      font-weight: var(--primary-bold);
      font-size: clamp(3.5rem, 5.6vw, 5rem);
      line-height: 1.3;
    }
    .building-stats_label { margin: 0; font-size: 1rem; line-height: 1.3; font-weight: var(--primary-bold); }
    @media (width < 64rem) {
      .building-stats_wrap { grid-template-columns: 1fr; gap: var(--space-7); }
      .building-stats_item { padding-left: 0; }
    }
  }
</style>
