---
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Button from "@/components/Button.astro";
import { getCoaches, type Coach } from "@/data/coaches";
import { contact } from "@/data/home";

interface Props {
  render?: boolean;
  class?: string;
  /** Override the list (otherwise pulled from Sanity, with fallback). */
  coaches?: Coach[];
}
const { render = true, class: className, coaches: override } = Astro.props;
const coaches = override ?? (await getCoaches());
---

{
  render && (
    <div class:list={["coach-grid_wrap", className]}>
      <div class="coach-grid_header">
        <Eyebrow>Coaches</Eyebrow>
        <Heading id="coaches-title">Meet our expert staff</Heading>
        <Paragraph class="max-width-none">Playing history and coaching credentials.</Paragraph>
      </div>
      <ul class="coach-grid_list" role="list">
        {coaches.map((coach) => (
          <li class="coach-grid_card">
            <div class="coach-grid_photo">
              {coach.photo ? (
                <img src={coach.photo} alt={coach.photoAlt ?? coach.name} loading="lazy" width="800" height="800" />
              ) : (
                <span class="coach-grid_placeholder" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="5" width="18" height="14" rx="2" /><circle cx="15.5" cy="9.5" r="1.5" /><path d="M3 17l5-5 4 4 3-3 6 6" /></svg>
                </span>
              )}
            </div>
            <div class="coach-grid_body">
              <h3 class="coach-grid_name">{coach.name}</h3>
              {coach.role && <p class="coach-grid_role">{coach.role}</p>}
              {coach.bio && <p class="coach-grid_bio">{coach.bio}</p>}
            </div>
          </li>
        ))}
      </ul>
      <div class="coach-grid_footer">
        <h3 class="coach-grid_cta">Want to coach here?</h3>
        <Button element="link" href={`${contact}?subject=Coaching%20at%20IPL`}>Contact us</Button>
      </div>
    </div>
  )
}

<style is:global>
  @layer components {
    .coach-grid_wrap { display: flex; flex-direction: column; align-items: center; gap: var(--space-8); width: 100%; }
    .coach-grid_header { display: flex; flex-direction: column; align-items: center; text-align: center; max-width: 48rem; }
    .coach-grid_header .eyebrow_wrap { margin-bottom: 1rem; }
    .coach-grid_header .heading { margin: 0 0 1.5rem; }
    .coach-grid_header .text { margin: 0; }
    .coach-grid_list {
      list-style: none; margin: 0; padding: 0; width: 100%;
      display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 4rem 3rem;
    }
    .coach-grid_card { display: flex; flex-direction: column; align-items: center; gap: 1.75rem; text-align: center; }
    .coach-grid_photo {
      width: 100%; aspect-ratio: 1; overflow: hidden;
      border-radius: 0.5rem; background: #d9d9d9;
    }
    .coach-grid_photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .coach-grid_placeholder { display: grid; place-items: center; width: 100%; height: 100%; color: #b3b3b3; }
    .coach-grid_placeholder svg { width: 22%; }
    .coach-grid_body { display: flex; flex-direction: column; align-items: center; gap: 0.75rem; }
    .coach-grid_name { margin: 0; font-weight: var(--primary-bold); font-size: 1.25rem; line-height: 1.6; letter-spacing: 0; }
    .coach-grid_role { margin: 0; font-size: 1.125rem; line-height: 1.67; }
    .coach-grid_bio { margin: 0.75rem 0 0; font-size: 1.0625rem; line-height: 1.65; max-width: 26rem; }
    .coach-grid_footer { display: flex; flex-direction: column; align-items: center; gap: 1.5rem; text-align: center; }
    .coach-grid_cta { margin: 0; font-weight: var(--primary-regular); font-size: clamp(1.625rem, 2.3vw, 2rem); line-height: 1.2; letter-spacing: -0.01em; }
    @media (width < 64rem) { .coach-grid_list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 3rem 2rem; } }
    @media (width < 40rem) { .coach-grid_list { grid-template-columns: 1fr; } }
  }
</style>
