---
import Form from "@/components/form/Form.astro";
import Input from "@/components/form/Input.astro";
import Textarea from "@/components/form/Textarea.astro";
import Choice from "@/components/form/Choice.astro";
import Select from "@/components/form/Select.astro";
import Fieldset from "@/components/form/Fieldset.astro";
import Button from "@/components/Button.astro";

interface Props {
  class?: string;
  /** Form endpoint. Leave empty until the form service is chosen. */
  action?: string;
  /** "contact": general question. "tour": tour request with athlete and timing fields (Book a Tour). */
  variant?: "contact" | "tour";
}
const { class: className, action, variant = "contact" } = Astro.props;
const tour = variant === "tour";
const ages = ["Under 8", "8 to 10", "11 to 13", "14 to 18", "College", "Adult"];
const sports = [{ label: "Baseball", value: "Baseball" }, { label: "Softball", value: "Softball" }, { label: "Both", value: "Both" }];
const times = ["Weekday morning", "Weekday afternoon", "Weekday evening", "Weekend", "Flexible"];
---

{tour ? (
<div class:list={["contact-form_card", "is-tour", "theme-light", className]} role="region" aria-label="Tour request form">
  <Form
    name="tour-request"
    action={action}
    successMessage="Request in. We will confirm your tour by text or email the same business day."
    errorMessage="That did not send. Please call (810) 206-3763 and we will book it over the phone."
  >
    <Fieldset legend="Your details" legendStyle="hidden" variant="columns">
      <Input label="Name" name="name" placeholder="" autocomplete="name" required />
      <Input label="Phone" name="phone" variant="phone" placeholder="" />
      <Input label="Email" name="email" variant="email" placeholder="" autocomplete="email" required />
      <Select label="Athlete age" name="athlete_age" options={ages} placeholder="Select an age" required />
    </Fieldset>
    <Fieldset legend="Sport" legendStyle="label" variant="inline">
      {sports.map((o) => <Choice type="radio" name="sport" {...o} required />)}
    </Fieldset>
    <Fieldset legend="When works" legendStyle="hidden" variant="columns">
      <Input label="Preferred day" name="preferred_day" variant="date" placeholder="" autocomplete="off" />
      <Select label="Preferred time" name="preferred_time" options={times} placeholder="Select a time" />
    </Fieldset>
    <Textarea label="Anything specific you want to see?" name="message" rows={4} placeholder="HitTrax, The Den, a lesson in progress..." />
    <Choice label="I accept the Privacy Policy" name="privacy" required />
    <p class="contact-form_note"><a href="mailto:info@ingeperformancelab.com?subject=Privacy%20Policy%20request">Read the Privacy Policy</a></p>
    <Button type="submit">Request a tour</Button>
  </Form>
</div>
) : (
<div class:list={["contact-form_card", "theme-light", className]} role="region" aria-label="Contact form">
  <Form
    name="contact"
    action={action}
    successMessage="Thanks. We will get back to you the same business day."
    errorMessage="That did not send. Please call (810) 206-3763 or try again."
  >
    <Input label="Name" name="name" placeholder="" autocomplete="name" required />
    <Input label="Email" name="email" variant="email" placeholder="" autocomplete="email" required />
    <Textarea label="What can we help with?" name="message" rows={6} placeholder="Age, sport, and what you are trying to fix..." required />
    <Choice label="I accept the Privacy Policy" name="privacy" required />
    <p class="contact-form_note"><a href="mailto:info@ingeperformancelab.com?subject=Privacy%20Policy%20request">Read the Privacy Policy</a></p>
    <Button type="submit">Send it</Button>
  </Form>
</div>
)}

<style is:global>
  @layer components {
    .contact-form_card {
            width: 100%;
      background: white;
      color: #000;
      border-radius: 0.8125rem;
      padding: 2.6875rem 1.6875rem;
      box-shadow: 0 1.125rem 1.25rem rgb(0 0 0 / 0.1), 0 4.625rem 2.3rem rgb(0 0 0 / 0.09);
    }
    .contact-form_card .form_fields { display: flex; flex-direction: column; gap: 1.625rem; }
    .contact-form_card .form_fields > button { align-self: flex-start; margin-top: 0.5rem; }
    .contact-form_card :is(input:not([type="checkbox"]), textarea) { min-height: 3.25rem; border-radius: 0.8125rem; }
    .contact-form_card :is(input, textarea):focus-visible { outline: 0.125rem solid var(--brand-500); outline-offset: 0.125rem; }
    .contact-form_note { margin: -0.75rem 0 0; font-size: 0.875rem; }
    .contact-form_note a { text-decoration: underline; text-underline-offset: 0.2em; color: #022337; transition: color 0.3s ease; }
    .contact-form_note a:hover { color: var(--brand-600); }
    .contact-form_card textarea { min-height: 12rem !important; height: 12rem; }
    /* Tour variant: more fields, so a shorter message box and select styling to match inputs */
    .contact-form_card.is-tour { box-shadow: none; padding: 0; background: transparent; }
    .contact-form_card.is-tour select { min-height: 3.25rem; border-radius: 0.8125rem; }
    .contact-form_card.is-tour textarea { min-height: 8rem !important; height: 8rem; }
    .contact-form_card.is-tour .form-fieldset.inline { gap: 0.75rem 1.75rem; }
  }
</style>
