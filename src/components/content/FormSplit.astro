---
/**
 * Form beside a photo (Contact 7). Intro and form on the left, image on the right.
 * Put the form component in the default slot, for example <ContactForm variant="tour" />.
 */
import SectionIntro from "@/components/content/SectionIntro.astro";

interface Props {
  eyebrow?: string;
  heading: string;
  text?: string;
  image: string;
  alt: string;
  /** CSS object-position for the photo. */
  position?: string;
  id?: string;
}
const { eyebrow, heading, text, image, alt, position, id } = Astro.props;
---

<div class="form-split_wrap">
  <div class="form-split_content">
    <SectionIntro eyebrow={eyebrow} heading={heading} text={text} align="start" id={id} />
    <slot />
  </div>
  <div class="form-split_media">
    <img src={image} alt={alt} loading="lazy" style={position ? `object-position: ${position}` : undefined} />
  </div>
</div>

<style is:global>
  @layer components {
    .form-split_wrap {
      display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(3rem, 6vw, 5rem); align-items: stretch; width: 100%;
    }
    .form-split_content { display: flex; flex-direction: column; gap: var(--space-6); }
    .form-split_media { position: relative; min-height: 32rem; border-radius: 0.8125rem; overflow: hidden; }
    .form-split_media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    @media (width < 64rem) {
      .form-split_wrap { grid-template-columns: 1fr; }
      .form-split_media { min-height: 16rem; }
    }
  }
</style>
