---
interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Utility classes. */
  class?: string;
}
const { render = true, class: className } = Astro.props;

/* Photos of Brandon framing the About hero. Horizontal positions are shares of
   the screen width taken from the 1440 Figma frame, so the outer cards always
   meet the screen edges. `speed` sets each card's parallax drift. */
const photos = [
  { file: "hero-5.webp", pos: "one", speed: 0.12, alt: "Brandon Inge fielding at third base" },
  { file: "hero-4.webp", pos: "two", speed: 0.22, alt: "Brandon Inge in his number 15 jersey" },
  { file: "hero-3.webp", pos: "three", speed: 0.3, alt: "Brandon Inge making a throw" },
  { file: "hero-2.webp", pos: "four", speed: 0.2, alt: "Brandon Inge at bat for the Detroit Tigers" },
  { file: "hero-1.webp", pos: "five", speed: 0.1, alt: "Brandon Inge in the Detroit Tigers dugout" },
];
---

{
  render && (
    <div class:list={["hero-about-backdrop_wrap", className]}>
      <div class="hero-about-backdrop_image" aria-hidden="true">
        <img src="/images/about/hero-bg.webp" alt="" fetchpriority="high" />
      </div>
      <div class="hero-about-backdrop_photos">
        {photos.map((photo) => (
          <img
            class:list={["hero-about-backdrop_photo", photo.pos]}
            src={`/images/about/${photo.file}`}
            alt={photo.alt}
            data-speed={photo.speed}
            loading="eager"
            decoding="async"
          />
        ))}
      </div>
    </div>
  )
}

<script>
  /* Cards drift upward at different rates as the page scrolls. Off for anyone
     who prefers reduced motion. */
  const cards = [
    ...document.querySelectorAll<HTMLElement>(".hero-about-backdrop_photo"),
  ];
  const reduced = matchMedia("(prefers-reduced-motion: reduce)");
  if (cards.length && !reduced.matches) {
    let frame = 0;
    const update = () => {
      frame = 0;
      const y = scrollY;
      if (y > innerHeight * 2) return;
      for (const card of cards) {
        const speed = Number(card.dataset.speed) || 0;
        card.style.setProperty("--_drift", `${(-y * speed).toFixed(1)}px`);
      }
    };
    addEventListener(
      "scroll",
      () => {
        if (!frame) frame = requestAnimationFrame(update);
      },
      { passive: true },
    );
    update();
    addEventListener("load", update, { once: true });
  }
</script>

<style is:global>
  @layer components {
    .hero-about-backdrop_wrap {
      position: absolute;
      inset: 0;
      pointer-events: none;
    }
    .hero-about-backdrop_image {
      position: absolute;
      inset: 0;
      overflow: clip;
      > img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0.25;
      }
      &::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(
          180deg,
          color-mix(in lab, var(--dark-900) 80%, transparent) 21.5%,
          #06649d85
        );
      }
    }
    /* Above the next section so the lower cards can overlap into it. */
    .hero-about-backdrop_photos {
      position: absolute;
      inset: 0;
      z-index: 2;
      @media (width < 64rem) {
        display: none;
      }
    }
    .hero-about-backdrop_photo {
      --_drift: 0px;
      position: absolute;
      width: clamp(13rem, 21.95vw, 19.75rem);
      aspect-ratio: 1;
      object-fit: cover;
      border-radius: var(--radius-small);
      translate: -50% var(--_drift);
      will-change: translate;
      &.one { left: 3.4%; top: 16.0625rem; }
      &.two { left: 19.65%; top: 38.8125rem; }
      &.three { left: 52.04%; top: 44.875rem; }
      &.four { left: 83.99%; top: 35.8125rem; }
      &.five { left: 96.57%; top: 8.9375rem; }
    }
  }
</style>
