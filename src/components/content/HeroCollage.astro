---
/** Right-half photo collage for split heroes (Header 77). Goes in a Section's background slot. */
interface Photo { src: string; alt?: string }
interface Props {
  photos: Photo[];
  /** "side": right half of a split hero, in the background slot. "band": full-width strip under centered hero copy. */
  variant?: "side" | "band";
}
const { photos, variant = "side" } = Astro.props;
const half = Math.ceil(photos.length / 2);
const rows = [photos.slice(0, half), photos.slice(half)];
---

<div class:list={["hero-collage", variant === "band" && "is-band"]} aria-hidden="true">
  {variant === "side" && <div class="hero-collage_glow"></div>}
  {rows.map((row, i) => (
    <div class:list={["hero-collage_row", i === 1 && "is-reverse"]}>
      {[...row, ...row].map((p) => <img src={p.src} alt="" loading="eager" />)}
    </div>
  ))}
</div>

<style is:global>
  @layer components {
    .hero-collage {
      position: absolute; inset: 0 0 0 auto; width: 62%;
      overflow: hidden;
      display: flex; flex-direction: column; justify-content: center; gap: 1rem;
      /* Photos dissolve into the copy side instead of stopping at a hard edge */
      -webkit-mask-image: linear-gradient(90deg, transparent 10%, rgb(0 0 0 / 0.25) 22%, rgb(0 0 0 / 0.7) 36%, #000 52%);
      mask-image: linear-gradient(90deg, transparent 10%, rgb(0 0 0 / 0.25) 22%, rgb(0 0 0 / 0.7) 36%, #000 52%);
    }
    .hero-collage_glow {
      position: absolute; inset: -20% -10%;
      background: radial-gradient(closest-side, rgb(14 120 190 / 0.45), transparent); filter: blur(3rem);
    }
    .hero-collage_row {
      position: relative; display: flex; gap: 1rem; width: max-content; height: 38%;
      animation: hero-collage-drift 60s linear infinite;
    }
    .hero-collage_row.is-reverse { animation-direction: reverse; margin-left: -12rem; }
    .hero-collage_row img { height: 100%; aspect-ratio: 416 / 340; object-fit: cover; border-radius: 0.5rem; }
    @keyframes hero-collage-drift { from { translate: 0 0; } to { translate: -50% 0; } }
    @media (prefers-reduced-motion: reduce) { .hero-collage_row { animation: none; } }
    @media (width < 64rem) { .hero-collage:not(.is-band) { display: none; } }
    /* Band: two drifting rows across the full width, edges fade into the navy */
    .hero-collage.is-band {
      position: relative; inset: auto; width: 100vw; margin-inline: calc(50% - 50vw); height: clamp(22rem, 34vw, 31rem);
      gap: 1rem; margin-bottom: var(--space-7);
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 8%, #000 92%, transparent 100%);
      mask-image: linear-gradient(90deg, transparent 0%, #000 8%, #000 92%, transparent 100%);
    }
    .hero-collage.is-band .hero-collage_row { height: calc(50% - 0.5rem); animation-duration: 80s; }
    .hero-collage.is-band .hero-collage_row.is-reverse { margin-left: -8rem; }
    .hero-collage.is-band img { aspect-ratio: 3 / 2; border-radius: 0.375rem; }
    @media (width < 48rem) { .hero-collage.is-band { height: 16rem; gap: 0.625rem; } .hero-collage.is-band .hero-collage_row { gap: 0.625rem; height: calc(50% - 0.3125rem); } }
    /* Split collage hero layout, shared by the Training hub and Support IPL:
       <Section class="feature-hero_section training-hero"> + <div class="training-hero_copy"> */
    .training-hero { min-height: max(40rem, 92svh); background: #011a29; }
    .training-hero .hero-collage::after {
      content: ""; position: absolute; inset: 0; pointer-events: none;
      background: linear-gradient(90deg, #011a29 0%, rgb(1 26 41 / 0.9) 22%, rgb(1 26 41 / 0.55) 40%, rgb(1 26 41 / 0) 62%);
    }
    .training-hero_copy { width: 50%; padding-right: 5rem; }
    .training-hero_copy .feature-hero_content { max-width: 35rem; }
    @media (width < 64rem) { .training-hero_copy { width: 100%; padding-right: 0; } }
  }
</style>
