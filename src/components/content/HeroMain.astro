---
import Heading from "@/components/typography/Heading.astro";
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Button from "@/components/Button.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import PartnerTicker from "@/components/content/PartnerTicker.astro";
import { booking } from "@/data/home";
interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Utility classes. */
  class?: string;
}
const { render = true, class: className } = Astro.props;

---

{
  render && (
    <div class:list={["hero-main_wrap", className]}>
      <div class="hero-main_content">
        <ContentWrapper>
          <Eyebrow>Baseball and Softball Training · Brighton, MI</Eyebrow>
          <Heading tag="h1" maxWidth={28}>
            Michigan’s premier baseball and softball training facility.
          </Heading>
          <Paragraph maxWidth={46}>
            Welcome to Inge Performance Lab: Cages, infield, strength training
            and mental performance under one roof. Measured on HitTrax, coached
            by professionals, and open year-round.
          </Paragraph>
          <ButtonWrapper>
            <>
              <Button element="link" href={booking}>
                Book a cage
              </Button>
              <Button element="link" href="/#contact" emphasis="secondary">
                Contact us
              </Button>
              <span class="hero-main_rating" role="img" aria-label="Rated 5.0 on Google">
                <img class="hero-main_laurel" src="/images/icons/google-laurel-left.webp" alt="" width="51" height="96" />
                <span class="hero-main_rating-body">
                  <img class="hero-main_google" src="/images/icons/google-g.svg" alt="" width="17" height="17" />
                  <span class="hero-main_stars">
                    {[0, 1, 2, 3, 4].map(() => (
                      <img src="/images/icons/google-star.svg" alt="" width="10" height="10" />
                    ))}
                  </span>
                  <span class="hero-main_rating-label">5.0 on Google</span>
                </span>
                <img class="hero-main_laurel" src="/images/icons/google-laurel-right.webp" alt="" width="51" height="96" />
              </span>
            </>
          </ButtonWrapper>
        </ContentWrapper>
        <div class="hero-main_partners">
          <PartnerTicker />
        </div>
      </div>
    </div>
  )
}
<style is:global>
  @layer components {
    .hero-main_wrap {
      /* At least 90% of the screen height, never shorter than the design. */
      min-height: max(49.6875rem, 90vh);
      min-height: max(49.6875rem, 90svh);
      display: flex;
      flex-direction: column;
      justify-content: center;
      position: relative;
      padding-block: 9rem var(--space-8);
      @media (width < 48rem) {
        min-height: max(46rem, 90vh);
        min-height: max(46rem, 90svh);
        padding-block: 8rem 4rem;
        justify-content: end;
        gap: var(--space-7);
        .hero-main_content {
          max-width: 100%;
        }
      }
    }
    /* Google rating badge, sized from Figma (Badge / Google Rating / A Stacked). */
    .hero-main_rating {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      align-self: center;
      margin-inline-start: var(--space-2);
    }
    .hero-main_laurel {
      width: 1.5625rem;
      height: 2.9375rem;
      object-fit: contain;
      opacity: 0.36;
    }
    .hero-main_rating-body {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.125rem;
    }
    .hero-main_google {
      width: 1.0625rem;
      height: 1.0625rem;
    }
    .hero-main_stars {
      display: flex;
      gap: 0.125rem;
      > img {
        width: 0.625rem;
        height: auto;
      }
    }
    .hero-main_rating-label {
      font-size: 0.75rem;
      line-height: 1.5;
      font-weight: var(--primary-medium);
      text-transform: uppercase;
      white-space: nowrap;
    }
    .hero-main_content {
      max-width: 56rem;
    }
    .hero-main_partners {
      width: 100%;
      margin-top: var(--space-7);
    }
  }
</style>
