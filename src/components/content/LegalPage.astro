---
/** Simple white text page for Privacy, Terms and Accessibility. Body comes in as rich text. */
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import Heading from "@/components/typography/Heading.astro";
import RichText from "@/components/typography/RichText.astro";

interface Props { title: string; updated: string; description?: string; intro?: string }
const { title, updated, description, intro } = Astro.props;
---

<Layout theme="light" title={`${title} | Inge Performance Lab`} description={description}>
  <Section theme="light" class="legal_section" aria-labelledby="legal-title">
    <article class="legal_wrap">
      <header class="legal_header">
        <Heading tag="h1" variant="h2" id="legal-title">{title}</Heading>
        <p class="legal_updated">Last updated {updated}</p>
        {intro && <p class="legal_intro">{intro}</p>}
      </header>
      <RichText class="legal_body"><slot /></RichText>
    </article>
  </Section>
</Layout>

<style is:global>
  @layer components {
    .legal_section { min-height: 0; background: #fff; color: #022337; padding-top: 10rem; }
    .legal_wrap { width: 100%; max-width: 46rem; margin-inline: auto; }
    .legal_header { padding-bottom: 2.5rem; margin-bottom: 2.5rem; border-bottom: 1px solid rgb(2 35 55 / 0.12); }
    .legal_header .heading { margin: 0; }
    .legal_updated { margin: 1.5rem 0 0; font-size: 0.9375rem; opacity: 0.7; }
    .legal_intro { margin: 1.5rem 0 0; font-size: 1.125rem; line-height: 1.65; }
    .legal_body { font-size: 1.0625rem; line-height: 1.7; }
    .legal_body h2 { font-size: 1.375rem; line-height: 1.3; font-weight: var(--primary-bold); margin: 2.75rem 0 1rem; text-box: none; }
    .legal_body h2:first-child { margin-top: 0; }
    .legal_body p { margin: 0 0 1.125rem; text-box: none; max-width: none; }
    .legal_body ul { list-style: disc; padding-left: 1.25rem; margin: 0 0 1.125rem; }
    .legal_body li { margin-bottom: 0.5rem; }
    .legal_body a { color: inherit; text-decoration: underline; text-underline-offset: 0.2em; }
    .legal_body a:hover { color: var(--brand-600); }
    @media (width < 64rem) { .legal_section { padding-top: 8rem; } }
  }
</style>
