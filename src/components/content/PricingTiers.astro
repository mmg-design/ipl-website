---
/** Global pricing section: dark tier cards with name pill, price, checklist, image and CTA. */
import SectionIntro from "@/components/content/SectionIntro.astro";
import Button from "@/components/Button.astro";
import { tipFor } from "@/data/pricing-glossary";

interface Tier {
  name: string; price: string; note?: string; features: string[];
  image?: string; alt?: string; cta: { label: string; href: string };
  /** CSS object-position for the photo, e.g. "50% 0%" to keep heads in frame. */
  imagePosition?: string;
  /** Accent ring to draw the eye to one tier. */
  featured?: boolean;
  /** Short label above the card, e.g. "Most popular". */
  badge?: string;
}
interface Props {
  eyebrow?: string; heading: string; text?: string; tiers: Tier[];
  /** Heading id. Set it when a page has more than one pricing block. */
  id?: string;
}
const { eyebrow, heading, text, tiers, id = "pricing-title" } = Astro.props;
const narrow = tiers.length <= 2;
const wide = tiers.length >= 4;
const uid = Math.random().toString(36).slice(2, 7);
---

<div class="pricing-tiers_wrap">
  <SectionIntro eyebrow={eyebrow} heading={heading} text={text} id={id} />
  <ul class:list={["pricing-tiers_list", narrow && "is-narrow", wide && "is-wide"]} role="list">
    {tiers.map((tier) => (
      <li class:list={["pricing-tiers_card theme-dark", tier.featured && "is-featured"]}>
        {tier.badge && <span class="pricing-tiers_badge">{tier.badge}</span>}
        <span class="pricing-tiers_pill">{tier.name}</span>
        <div class="pricing-tiers_price">
          <p class="pricing-tiers_amount">{tier.price}</p>
          {tier.note && <p class="pricing-tiers_note">{tier.note}</p>}
        </div>
        <ul class="pricing-tiers_features" role="list">
          {tier.features.map((f, j) => {
            const tip = tipFor(f);
            const tid = `tip-${uid}-${tiers.indexOf(tier)}-${j}`;
            return (
              <li>
                <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="9" fill="currentColor" /><path d="M6 10.2l2.6 2.6L14 7.4" fill="none" stroke="#0b3550" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <span>{f}</span>
                {tip && (
                  <span class="pricing-tip">
                    <button type="button" class="pricing-tip_btn" aria-describedby={tid} aria-label={`About: ${f}`}>
                      <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.3" /><path d="M8 7.2v4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /><circle cx="8" cy="4.9" r="0.85" fill="currentColor" /></svg>
                    </button>
                    <span class="pricing-tip_bubble" role="tooltip" id={tid}>{tip}</span>
                  </span>
                )}
              </li>
            );
          })}
        </ul>
        {tier.image && <img class="pricing-tiers_image" src={tier.image} alt={tier.alt ?? ""} loading="lazy" style={tier.imagePosition ? `object-position: ${tier.imagePosition}` : undefined} />}
        <Button element="link" href={tier.cta.href} class="pricing-tiers_cta" aria-label={`${tier.cta.label} ${tier.name}`}>{tier.cta.label}</Button>
      </li>
    ))}
  </ul>
</div>

<style is:global>
  @layer components {
    .pricing-tiers_wrap { display: flex; flex-direction: column; gap: var(--space-8); width: 100%; }
    .pricing-tiers_list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); gap: 2rem; }
    .pricing-tiers_list.is-narrow { max-width: 64rem; margin-inline: auto; width: 100%; }
    .pricing-tiers_card {
      display: flex; flex-direction: column; align-items: center; gap: 2rem;
      padding: 3rem 2.25rem 2.5rem; border-radius: 0.75rem; color: white;
      border: var(--border-width) solid #1d3a4f;
      background: linear-gradient(180deg, rgb(255 255 255 / 0) 0%, rgb(255 255 255 / 0.015) 60%, rgb(255 255 255 / 0.07) 100%), #0b3550;
      box-shadow: 0 0.125rem 0.375rem rgb(1 26 41 / 0.18), 0 0.75rem 2rem rgb(1 26 41 / 0.28);
    }
    .pricing-tiers_card { position: relative; }
    .pricing-tiers_card.is-featured {
      border-color: var(--brand-500);
      box-shadow: 0 0 0 1px var(--brand-500), 0 0.125rem 0.375rem rgb(1 26 41 / 0.18), 0 1rem 2.5rem rgb(1 26 41 / 0.4);
    }
    .pricing-tiers_badge {
      position: absolute; top: 0; left: 50%; translate: -50% -50%; white-space: nowrap;
      font-size: 0.75rem; font-weight: var(--primary-bold); letter-spacing: 0.08em; text-transform: uppercase;
      padding: 0.375rem 0.875rem; border-radius: 999px; background: var(--brand-500); color: white;
    }
    .pricing-tiers_pill {
      font-size: 0.875rem; font-weight: var(--primary-bold); letter-spacing: 0.06em; text-transform: uppercase; line-height: 1.3;
      padding: 0.375rem 0.875rem; border-radius: 999px;
      background: rgb(255 255 255 / 0.14); border: 1px solid rgb(255 255 255 / 0.28);
    }
    .pricing-tiers_price { display: flex; flex-direction: column; align-items: center; gap: 0.875rem; text-align: center; padding-top: 0.25rem; }
    .pricing-tiers_price > p { margin: 0; }
    .pricing-tiers_amount { font-size: clamp(2.75rem, 4vw, 3.625rem); font-weight: 900; line-height: 1.02; letter-spacing: -0.025em; }
    .pricing-tiers_note { font-size: 0.9375rem; line-height: 1.5; opacity: 0.85; }
    .pricing-tiers_features { list-style: none; margin: 0; padding: 0.25rem 0 0; width: 100%; display: flex; flex-direction: column; gap: 0.75rem; border-top: 1px solid rgb(255 255 255 / 0.1); padding-top: 1.5rem; }
    .pricing-tiers_features li { display: flex; align-items: center; gap: 0.5rem; font-size: 0.9375rem; line-height: 1.45; }
    .pricing-tiers_features li > svg { width: 1rem; height: 1rem; flex: none; color: white; }
    /* Info tooltips */
    .pricing-tip { position: relative; display: inline-flex; margin-left: 0.125rem; }
    .pricing-tip_btn { display: inline-flex; width: 1.5rem; height: 1.5rem; align-items: center; justify-content: center; color: rgb(255 255 255 / 0.55); border-radius: 50%; cursor: help; transition: color 0.2s; }
    .pricing-tip_btn svg { width: 0.9375rem; height: 0.9375rem; }
    .pricing-tip_btn:hover, .pricing-tip_btn:focus-visible { color: #fff; }
    .pricing-tip_btn:focus-visible { outline: 2px solid var(--brand-500); outline-offset: 1px; }
    .pricing-tip_bubble {
      position: absolute; z-index: 20; bottom: calc(100% + 0.5rem); left: 50%; translate: -50% 0.25rem;
      width: max-content; max-width: 15rem; padding: 0.625rem 0.75rem; border-radius: 0.5rem;
      background: #fff; color: #022337; font-size: 0.8125rem; line-height: 1.45; font-weight: 500;
      box-shadow: 0 0.75rem 1.5rem rgb(1 26 41 / 0.35);
      display: none; opacity: 0; pointer-events: none; transition: opacity 0.2s, translate 0.2s, display 0.2s allow-discrete;
    }
    @media (width < 48rem) { .pricing-tip_bubble { left: auto; right: -0.5rem; translate: 0 0.25rem; max-width: min(15rem, 70vw); } .pricing-tip:hover .pricing-tip_bubble, .pricing-tip:focus-within .pricing-tip_bubble { translate: 0 0; } }
    .pricing-tip:hover .pricing-tip_bubble, .pricing-tip:focus-within .pricing-tip_bubble { display: block; opacity: 1; translate: -50% 0; }
    @starting-style { .pricing-tip:hover .pricing-tip_bubble, .pricing-tip:focus-within .pricing-tip_bubble { opacity: 0; } }
    /* Four-across layout (Memberships): tighter cards so checklist lines fit */
    .pricing-tiers_list.is-wide { grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 1.25rem; }
    .pricing-tiers_list.is-wide .pricing-tiers_card { padding: 2.75rem 1.5rem 2rem; gap: 1.75rem; }
    .pricing-tiers_list.is-wide .pricing-tiers_features li { font-size: 0.875rem; }
    .pricing-tiers_list.is-wide .pricing-tiers_amount { font-size: clamp(2.5rem, 3.4vw, 3.125rem); }
    .pricing-tiers_image { width: 100%; flex: 1 1 auto; min-height: 9.5rem; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 0.5rem; }
    .pricing-tiers_cta { width: 100%; justify-content: center; margin-top: auto; }
  }
</style>
