---
/** Global pricing section: dark tier cards with name pill, price, checklist, image and CTA. */
import SectionIntro from "@/components/content/SectionIntro.astro";
import Button from "@/components/Button.astro";

interface Tier {
  name: string; price: string; note?: string; features: string[];
  image?: string; alt?: string; cta: { label: string; href: string };
}
interface Props { eyebrow?: string; heading: string; text?: string; tiers: Tier[] }
const { eyebrow, heading, text, tiers } = Astro.props;
const narrow = tiers.length <= 2;
---

<div class="pricing-tiers_wrap">
  <SectionIntro eyebrow={eyebrow} heading={heading} text={text} id="pricing-title" />
  <ul class:list={["pricing-tiers_list", narrow && "is-narrow"]} role="list">
    {tiers.map((tier) => (
      <li class="pricing-tiers_card theme-dark">
        <span class="pricing-tiers_pill">{tier.name}</span>
        <div class="pricing-tiers_price">
          <p class="pricing-tiers_amount">{tier.price}</p>
          {tier.note && <p class="pricing-tiers_note">{tier.note}</p>}
        </div>
        <ul class="pricing-tiers_features" role="list">
          {tier.features.map((f) => (
            <li>
              <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="9" fill="currentColor" /><path d="M6 10.2l2.6 2.6L14 7.4" fill="none" stroke="#0b3550" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
              <span>{f}</span>
            </li>
          ))}
        </ul>
        {tier.image && <img class="pricing-tiers_image" src={tier.image} alt={tier.alt ?? ""} loading="lazy" />}
        <Button element="link" href={tier.cta.href} class="pricing-tiers_cta" aria-label={`${tier.cta.label} ${tier.name}`}>{tier.cta.label}</Button>
      </li>
    ))}
  </ul>
</div>

<style is:global>
  @layer components {
    .pricing-tiers_wrap { display: flex; flex-direction: column; gap: var(--space-8); width: 100%; }
    .pricing-tiers_list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); gap: 2rem; }
    .pricing-tiers_list.is-narrow { max-width: 64rem; margin-inline: auto; width: 100%; }
    .pricing-tiers_card {
      display: flex; flex-direction: column; align-items: center; gap: 1.75rem;
      padding: 2rem 1.75rem 1.75rem; border-radius: 0.75rem; color: white;
      border: var(--border-width) solid #1d3a4f;
      background: linear-gradient(180deg, rgb(255 255 255 / 0) 0%, rgb(255 255 255 / 0.015) 60%, rgb(255 255 255 / 0.07) 100%), #0b3550;
      box-shadow: 0 0.125rem 0.375rem rgb(1 26 41 / 0.18), 0 0.75rem 2rem rgb(1 26 41 / 0.28);
    }
    .pricing-tiers_pill {
      font-size: 0.875rem; font-weight: var(--primary-bold); letter-spacing: 0.06em; text-transform: uppercase; line-height: 1.3;
      padding: 0.375rem 0.875rem; border-radius: 999px;
      background: rgb(255 255 255 / 0.14); border: 1px solid rgb(255 255 255 / 0.28);
    }
    .pricing-tiers_price { display: flex; flex-direction: column; align-items: center; gap: 1.25rem; text-align: center; padding-top: 0.25rem; }
    .pricing-tiers_price > p { margin: 0; }
    .pricing-tiers_amount { font-size: clamp(2.75rem, 4vw, 3.625rem); font-weight: var(--primary-bold); line-height: 1.02; letter-spacing: -0.025em; }
    .pricing-tiers_note { font-size: 0.9375rem; line-height: 1.5; opacity: 0.85; }
    .pricing-tiers_features { list-style: none; margin: 0; padding: 0.5rem 0 0.25rem; width: 100%; display: flex; flex-direction: column; gap: 0.875rem; }
    .pricing-tiers_features li { display: flex; align-items: center; gap: 0.625rem; font-size: 1.0625rem; line-height: 1.65; }
    .pricing-tiers_features svg { width: 1.25rem; height: 1.25rem; flex: none; color: white; }
    .pricing-tiers_image { width: 100%; flex: 1 1 auto; min-height: 9.5rem; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 0.5rem; }
    .pricing-tiers_cta { width: 100%; justify-content: center; margin-top: auto; }
  }
</style>
