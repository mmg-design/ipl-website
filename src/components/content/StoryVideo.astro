---
interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Utility classes. */
  class?: string;
}
const { render = true, class: className } = Astro.props;
const video = "https://IPLPullZone.b-cdn.net/Main%20Website%20Video.mp4";
const poster = "/images/about/story-poster.webp";
---

{
  render && (
    <div class:list={["story-video_wrap", className]} data-story-video>
      <video
        class="story-video_media"
        src={video}
        poster={poster}
        playsinline
        preload="none"
        aria-label="Brandon Inge walking through Inge Performance Lab"
      />
      <button class="story-video_play" type="button" aria-label="Play the story video">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
      </button>
    </div>
  )
}

<script>
  document.querySelectorAll<HTMLElement>("[data-story-video]").forEach((wrap) => {
    const video = wrap.querySelector("video")!;
    const button = wrap.querySelector("button")!;
    button.addEventListener("click", () => {
      wrap.classList.add("is-playing");
      video.controls = true;
      video.play();
    });
    video.addEventListener("ended", () => wrap.classList.remove("is-playing"));
  });
</script>

<style is:global>
  @layer components {
    .story-video_wrap {
      position: relative;
      width: 100%;
      aspect-ratio: 1280 / 733;
      border-radius: var(--radius-main, 0.75rem);
      overflow: hidden;
      background: var(--dark-900, #022337);
      box-shadow: 0 2rem 6rem -2rem color-mix(in lab, #022337 35%, transparent);
    }
    .story-video_media {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .story-video_play {
      position: absolute;
      inset: 50% auto auto 50%;
      translate: -50% -50%;
      width: clamp(4.5rem, 7vw, 6.25rem);
      aspect-ratio: 1;
      display: grid;
      place-items: center;
      border: 0;
      border-radius: 50%;
      background: white;
      color: #000;
      cursor: pointer;
      box-shadow: 0 0.75rem 2.5rem -0.5rem rgb(0 0 0 / 0.45);
      transition: scale 0.3s ease;
    }
    .story-video_play svg { width: 42%; translate: 6% 0; }
    .story-video_play:hover { scale: 1.06; }
    .story-video_play:focus-visible { outline: 0.1875rem solid var(--orange-500, #f25c05); outline-offset: 0.25rem; }
    .story-video_wrap.is-playing .story-video_play { opacity: 0; pointer-events: none; }
  }
</style>
