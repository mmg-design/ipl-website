---
interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Utility classes. */
  class?: string;
}
const { render = true, class: className } = Astro.props;
const video = "https://IPLPullZone.b-cdn.net/Main_compressed.mp4";
/** Seconds of silent preview that loop before someone presses play. */
const previewSeconds = 3;
const poster = "/images/about/story-poster.webp";
---

{
  render && (
    <div class:list={["story-video_wrap", className]} data-story-video data-src={video} data-preview={previewSeconds}>
      <video
        class="story-video_media"
        poster={poster}
        playsinline
        muted
        preload="none"
        aria-label="Brandon Inge walking through Inge Performance Lab"
      />
      <button class="story-video_play" type="button" aria-label="Play the story video">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6.8v10.4a1 1 0 0 0 1.5.86l8.3-5.2a1 1 0 0 0 0-1.72l-8.3-5.2A1 1 0 0 0 9 6.8z" fill="currentColor" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
      </button>
    </div>
  )
}

<script>
  /* Silent 3-second preview loop. The file is only requested once the player
     scrolls into view, the browser streams just the opening seconds, and nothing
     loads for reduced-motion or data-saver visitors until they press play. */
  document.querySelectorAll<HTMLElement>("[data-story-video]").forEach((wrap) => {
    const video = wrap.querySelector("video")!;
    const button = wrap.querySelector("button")!;
    const src = wrap.dataset.src!;
    const limit = Number(wrap.dataset.preview) || 3;
    const quiet = matchMedia("(prefers-reduced-motion: reduce)").matches || (navigator as any).connection?.saveData;
    let previewing = false;

    const loopPreview = () => { if (previewing && video.currentTime >= limit) video.currentTime = 0; };
    video.addEventListener("timeupdate", loopPreview);

    if (!quiet && "IntersectionObserver" in window) {
      const io = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            if (!video.src) video.src = src;
            if (!wrap.classList.contains("is-playing")) { previewing = true; video.play().catch(() => {}); }
          } else if (previewing) video.pause();
        }
      }, { rootMargin: "200px 0px" });
      io.observe(wrap);
    }

    button.addEventListener("click", () => {
      previewing = false;
      if (!video.src) video.src = src;
      wrap.classList.add("is-playing");
      video.currentTime = 0;
      video.muted = false;
      video.controls = true;
      video.play();
    });
    video.addEventListener("ended", () => { wrap.classList.remove("is-playing"); video.controls = false; });
  });
</script>

<style is:global>
  @layer components {
    .story-video_wrap {
      position: relative;
      width: 100%;
      aspect-ratio: 1280 / 733;
      border-radius: var(--radius-main, 0.75rem);
      overflow: hidden;
      background: var(--dark-900, #022337);
      box-shadow: 0 2rem 6rem -2rem color-mix(in lab, #022337 35%, transparent);
    }
    .story-video_media {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .story-video_play {
      position: absolute;
      inset: 50% auto auto 50%;
      translate: -50% -50%;
      width: clamp(4.5rem, 7vw, 6.25rem);
      aspect-ratio: 1;
      display: grid;
      place-items: center;
      border: 0;
      border-radius: 50%;
      color: #fff;
      cursor: pointer;
      background: radial-gradient(circle at 35% 30%, #ff6a4d 0%, var(--brand-500, #ef4023) 45%, #c8361c 100%);
      box-shadow:
        inset 0 2px 0 rgb(255 255 255 / 0.35),
        inset 0 -4px 10px rgb(120 20 5 / 0.35),
        0 0 0 0.5rem rgb(239 64 35 / 0.18),
        0 1rem 2.5rem -0.5rem rgb(0 0 0 / 0.55);
      transition: scale 0.3s ease, box-shadow 0.3s ease;
    }
    /* The triangle's visual center sits left of its box, so nudge it right to look centered. */
    .story-video_play svg { width: 44%; height: 44%; display: block; translate: 4% 0; filter: drop-shadow(0 2px 3px rgb(90 15 0 / 0.35)); }
    .story-video_play:hover {
      scale: 1.06;
      box-shadow:
        inset 0 2px 0 rgb(255 255 255 / 0.35),
        inset 0 -4px 10px rgb(120 20 5 / 0.35),
        0 0 0 0.75rem rgb(239 64 35 / 0.22),
        0 1.25rem 3rem -0.5rem rgb(0 0 0 / 0.6);
    }
    .story-video_play:focus-visible { outline: 0.1875rem solid #fff; outline-offset: 0.375rem; }
    .story-video_wrap.is-playing .story-video_play { opacity: 0; pointer-events: none; }
  }
</style>
