---
interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Utility classes. */
  class?: string;
}
const { render = true, class: className } = Astro.props;
import caveat from "@/assets/fonts/Caveat-VariableFont_wght.ttf?url";
const video = "https://IPLPullZone.b-cdn.net/HitTrax%20Video.mp4";
const poster = "/images/figma/technology-0.webp";
---

<style
  is:global
  set:html={`@font-face{font-family:"Caveat";src:url("${caveat}") format("truetype");font-weight:400 700;font-display:swap;}`}
/>

{
  render && (
    <div class:list={["technology-gallery_wrap", className]}>
      <div class="technology-gallery_note">
        watch HitTrax in action
        <img src="/images/figma/1f47e.svg" alt="" loading="lazy" />
      </div>
      <div class="technology-gallery_feature">
        <video
          class="technology-gallery_preview"
          src={`${video}#t=0,3`}
          poster={poster}
          muted
          autoplay
          playsinline
          preload="metadata"
          disablepictureinpicture
          tabindex="-1"
          aria-label="Brandon Inge demonstrating swing data on a HitTrax screen"
        />
      </div>
      <div class="technology-gallery_image">
        <img
          src="/images/figma/31bca.webp"
          alt="An athlete reviewing HitTrax results"
          loading="lazy"
        />
      </div>
      <div class="technology-gallery_image batter">
        <img
          src="/images/figma/bba82.webp"
          alt="Hitting practice in a training cage"
          loading="lazy"
        />
      </div>
      <div class="technology-gallery_image screen">
        <img
          src="/images/figma/b9f3d.webp"
          alt="HitTrax swing tracking technology"
          loading="lazy"
        />
      </div>
    </div>
  )
}
<script>
  /* Loop only the first three seconds, so the rest of the clip never loads. */
  const PREVIEW_END = 3;
  for (const preview of document.querySelectorAll<HTMLVideoElement>(
    ".technology-gallery_preview",
  )) {
    preview.addEventListener("timeupdate", () => {
      if (preview.currentTime >= PREVIEW_END) {
        preview.currentTime = 0;
        preview.play().catch(() => {});
      }
    });
  }
</script>
<style is:global>
  @layer components {
    .technology-gallery_wrap {
      display: grid;
      grid-template-columns: 1.65fr 1fr 1fr 1fr;
      align-items: end;
      gap: var(--space-3);
      position: relative;
      width: 100%;
      padding-top: 0;
      @media (width < 48rem) {
        grid-template-columns: 1fr 1fr;
        margin-top: var(--space-8);
        .technology-gallery_feature {
          grid-row: span 2;
          align-self: stretch;
        }
        .technology-gallery_image:last-child {
          grid-column: span 2;
          aspect-ratio: 2;
        }
        .technology-gallery_note {
          font-size: 1.25rem;
          top: -3rem;
        }
      }
    }
    .technology-gallery_note {
      position: absolute;
      left: 0.75rem;
      top: -6rem;
      font-family: "Caveat", cursive;
      font-weight: 500;
      font-size: 1.6875rem;
      transform: rotate(-4deg);
    }
    .technology-gallery_note > img {
      position: absolute;
      right: 2rem;
      top: 100%;
      width: auto;
      height: auto;
      transform: rotate(41deg);
    }
    .technology-gallery_feature,
    .technology-gallery_image {
      overflow: hidden;
      border-radius: var(--radius-main);
    }
    .technology-gallery_feature {
      aspect-ratio: 442 / 589;
      position: relative;
      background: var(--dark-950);
    }
    .technology-gallery_preview {
      width: 100%;
      height: 100%;
      object-fit: cover;
      pointer-events: none;
    }
    .technology-gallery_image {
      aspect-ratio: 3 / 4;
      position: relative;
    }
    .technology-gallery_wrap > div > img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .technology-gallery_wrap .technology-gallery_note > img {
      width: auto;
      height: auto;
    }
    .technology-gallery_image.batter > img {
      position: absolute;
      height: 121.29%;
      width: 129.42%;
      max-width: none;
      left: -29.62%;
      top: -21.29%;
    }
    .technology-gallery_image.screen > img {
      position: absolute;
      height: 100%;
      width: 240.51%;
      max-width: none;
      left: -70.26%;
      top: 0;
    }
  }
</style>
