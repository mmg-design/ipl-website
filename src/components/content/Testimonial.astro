---
interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Testimonial text. */
  quote: string;
  /** Author name. */
  author: string;
  /** Author description. */
  role: string;
  /** Utility classes. */
  class?: string;
}
const { render = true, quote, author, role, class: className } = Astro.props;
---

{
  render && quote && (
    <figure class:list={["testimonial_wrap", className]}>
      <img
        class="testimonial_stars"
        src="/images/figma/1d3b9.svg"
        alt="Five stars"
        loading="lazy"
      />
      <blockquote class="testimonial_quote">“{quote}”</blockquote>
      <figcaption class="testimonial_author">
        <>
          <img
            src="/images/figma/779fe.webp"
            alt=""
            width="48"
            height="48"
            loading="lazy"
          />
          <div>
            <>
              <strong>{author}</strong>
              <p>{role}</p>
            </>
          </div>
        </>
      </figcaption>
    </figure>
  )
}
<style is:global>
  @layer components {
    .testimonial_wrap {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      padding: var(--space-5);
      background: var(--dark-800);
      border: var(--border-width) solid var(--line-strong);
      border-radius: var(--radius-small);
      height: 100%;
    }
    .testimonial_stars {
      width: auto;
      height: auto;
      max-width: none;
      align-self: start;
    }
    .testimonial_quote {
      font-size: var(--text-large);
      line-height: 1.6;
    }
    .testimonial_author {
      display: flex;
      gap: var(--space-3);
      align-items: center;
      margin-top: auto;
      font-size: 1.0625rem;
      line-height: 1.65;
    }
    .testimonial_author > img {
      width: 3rem;
      height: 3rem;
      flex: none;
    }
  }
</style>
