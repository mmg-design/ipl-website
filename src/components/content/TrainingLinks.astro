---
/** "Keep training" row: small cards linking to every other training page. Pulls from the nav's training list. */
import SectionIntro from "@/components/content/SectionIntro.astro";
import { training } from "@/data/home";

interface Props { current: string; eyebrow?: string; heading?: string; text?: string }
const {
  current,
  eyebrow = "More at the Lab",
  heading = "Other training pathways.",
  text = "Most athletes here work on more than one part of their game. Here's where else they train.",
} = Astro.props;

/* Per-photo framing for a small 4:3 crop */
const framing: Record<string, string> = {
  baseball: "50% 40%",
  softball: "50% 30%",
  pitching: "35% 30%",
  "mental-performance": "50% 35%",
  "team-training": "50% 55%",
};
const links = training.filter((t) => t.id !== current);
---

<div class="training-links_wrap">
  <SectionIntro eyebrow={eyebrow} heading={heading} text={text} variant="h2" align="start" />
  <ul class="training-links_list" role="list">
    {links.map((t) => (
      <li>
        <a class="training-links_card" href={t.href}>
          <span class="training-links_photo">
            <img src={t.image} alt="" loading="lazy" style={`object-position: ${framing[t.id] ?? "50% 50%"}`} />
          </span>
          <span class="training-links_body">
            <span class="training-links_title"><span class="training-links_icon"><img src={t.icon} alt="" /></span>{t.heading}</span>
            <span class="training-links_text">{t.text}</span>
          </span>
          <span class="training-links_arrow" aria-hidden="true">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10h12M11 5l5 5-5 5" /></svg>
          </span>
        </a>
      </li>
    ))}
  </ul>
</div>

<style is:global>
  @layer components {
    .training-links_wrap { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); align-items: center; gap: var(--space-8); width: 100%; }
    .training-links_list { list-style: none; margin: 0; padding: 0; width: 100%; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
    .training-links_card {
      position: relative; display: flex; flex-direction: column; height: 100%; padding: 0.625rem 0.625rem 1.25rem;
      background: #fff; border: 1px solid rgb(2 35 55 / 0.1); border-radius: 1.125rem; color: #022337;
      transition: translate 0.35s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.35s, border-color 0.35s;
    }
    .training-links_card:focus-visible { outline: 2px solid var(--brand-500); outline-offset: 3px; }
    .training-links_photo { position: relative; display: block; aspect-ratio: 4 / 3; border-radius: 0.75rem; overflow: hidden; background: #022337; }
    .training-links_card:hover, .training-links_card:focus-visible {
      translate: 0 -0.375rem; border-color: rgb(2 35 55 / 0.14);
      box-shadow: 0 1.5rem 3rem -1rem rgb(2 35 55 / 0.28), 0 0.5rem 1rem -0.5rem rgb(2 35 55 / 0.12);
    }
    .training-links_photo > img { width: 100%; height: 100%; object-fit: cover; }
    .training-links_icon {
      display: inline-grid; place-items: center; flex: none; width: 2rem; height: 2rem;
      border-radius: var(--radius-small, 0.5rem); background: linear-gradient(#ffffff22, #ffffff00), var(--brand-500);
      box-shadow: 0 0.5rem 1rem -0.25rem rgb(0 0 0 / 0.35);
    }
    .training-links_icon > img { width: 1.125rem; height: 1.125rem; object-fit: contain; }
    .training-links_body { display: flex; flex-direction: column; gap: 0.75rem; padding: 1.125rem 0.625rem 0; padding-right: 2.5rem; }
    .training-links_title { display: flex; align-items: center; gap: 0.75rem; font-size: 1.1875rem; font-weight: var(--primary-bold); line-height: 1.2; }
    .training-links_text { font-size: 0.9375rem; line-height: 1.5; color: rgb(2 35 55 / 0.7); }
    .training-links_arrow {
      position: absolute; right: 1.125rem; bottom: 1.25rem; width: 1.25rem; height: 1.25rem; color: var(--brand-500);
    }
    @media (width < 64rem) { .training-links_wrap { grid-template-columns: 1fr; } }
    @media (width < 30rem) { .training-links_list { grid-template-columns: 1fr; } }
  }
</style>
