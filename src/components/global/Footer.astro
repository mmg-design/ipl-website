---
import { booking, contact } from "@/data/home";
interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}
const { render = true } = Astro.props;
const columns = [
  {
    label: "Facility",
    links: [
      ["Batting Cages", "/batting-cages"],
      ["HitTrax", "/hittrax"],
      ["The Den", "/the-den"],
      ["Team Rentals", "/#team-training"],
      ["Book a Tour", contact + "?subject=Facility%20tour"],
      ["All Features", "/#facility"],
    ],
  },
  {
    label: "Training",
    links: [
      ["Baseball Training", "/#baseball"],
      ["Softball Training", "/#softball"],
      ["Pitching", "/#pitching"],
      ["Mental Performance", "/#mental-performance"],
      ["Programs", "/#programs"],
      ["Memberships", "/#memberships"],
    ],
  },
  {
    label: "Company",
    links: [
      ["About IPL", "/about"],
      ["Our Coaches", "/about#coaches"],
      ["Events", "/#programs"],
      ["Support IPL", contact + "?subject=Support%20IPL"],
      ["Contact", "/contact"],
    ],
  },
];
const social = [
  ["Instagram", "f10af.svg"],
  ["Facebook", "5ebab.svg"],
  ["YouTube", "987e2.svg"],
  ["X", "1bc14.svg"],
  ["LinkedIn", "c2305.svg"],
];
---

{
  render && (
    <footer class="footer_wrap theme-dark" id="about">
      <div class="footer_inner">
        <div class="footer_top">
          <a
            class="footer_booking"
            href={booking}
            aria-label="Inquire about booking a session"
          >
            <div class="footer_booking_content">
              <>
                <span class="footer_badge">Swift booking</span>
                <h2 class="footer_booking_title">
                  Reserve sessions
                  <br />
                  on the go.
                </h2>
              </>
            </div>
            <img
              src="/images/figma/647c8.webp"
              alt="The Swift booking app shown on a phone"
              loading="lazy"
            />
          </a>
          <div class="footer_info">
            <div class="footer_columns">
              {columns.map((column) => (
                <nav class="footer_column" aria-label={column.label}>
                  <h2 class="footer_label">{column.label}</h2>
                  <ul>
                    {column.links.map(([label, href]) => (
                      <li>
                        <a class="footer_link has-arrow" href={href}>
                          <span>{label}</span>
                          <svg class="footer_link_arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                          </svg>
                        </a>
                      </li>
                    ))}
                  </ul>
                </nav>
              ))}
              <div class="footer_column contact">
                <>
                  <img
                    class="footer_logo"
                    src="/images/figma/795a9.webp"
                    alt="Inge Performance Lab"
                    width="138"
                    height="71"
                    loading="lazy"
                  />
                  <address class="footer_contact">
                    <>
                      <a
                        class="footer_link"
                        href="https://www.google.com/maps/search/?api=1&query=8101+Movie+Dr+Brighton+MI+48116"
                      >
                        8101 Movie Dr
                        <br />
                        Brighton, MI 48116
                      </a>
                      <a class="footer_link" href="tel:+18102063763">
                        (810) 206-3763
                      </a>
                      <a class="footer_link" href={contact}>
                        info@ingeperformancelab.com
                      </a>
                      <p>
                        Mon–Fri 2–9 PM
                        <br />
                        Sat 10–7 · Sun 11–5
                      </p>
                    </>
                  </address>
                </>
              </div>
            </div>
            <div class="footer_social" aria-label="Social media">
              {social.map(([label, file]) => (
                <span class="footer_social_icon" title={label} role="img" aria-label={label} style={`--_icon: url(/images/figma/${file})`} />
              ))}
            </div>
          </div>
        </div>
        <div class="footer_bottom">
          <>
            <p>
              © {new Date().getFullYear()} Inge Performance Lab. All rights
              reserved.
            </p>
            <ul class="footer_legal">
              {[
                "Privacy Policy",
                "Terms & Conditions",
                "Waiver",
                "Facility Policies",
                "Accessibility",
              ].map((label) => (
                <li>
                  <a
                    class="footer_link"
                    href={`${contact}?subject=${encodeURIComponent(label + " request")}`}
                  >
                    {label}
                  </a>
                </li>
              ))}
            </ul>
            <p>Site by MMG Studio</p>
          </>
        </div>
      </div>
    </footer>
  )
}
<style is:global>
  @layer components {
    .footer_wrap {
      background: var(--dark-1000);
      padding: 7.5rem var(--site-margin) var(--space-7);
      @media (width < 64rem) {
        .footer_top {
          grid-template-columns: 1fr;
        }
        .footer_booking {
          width: min(22rem, 100%);
          margin-inline: auto;
        }
        .footer_columns {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: var(--space-7);
        }
        .footer_bottom {
          flex-direction: column;
          align-items: start;
        }
      }
    }
    .footer_inner {
      max-width: 82rem;
      margin-inline: auto;
    }
    .footer_top {
      display: grid;
      grid-template-columns: 21.875rem minmax(0, 1fr);
      gap: var(--section-space-small);
    }
    .footer_booking {
      display: block;
      position: relative;
      min-height: 33.25rem;
      border-radius: 1.125rem;
      background: linear-gradient(transparent, #ef402387);
      overflow: hidden;
    }
    .footer_booking_content {
      position: relative;
      z-index: 1;
      text-align: center;
      padding: 1.5rem;
    }
    .footer_badge {
      display: inline-flex;
      padding: 0.375rem 0.875rem;
      border: var(--border-width) solid #ffffff47;
      border-radius: var(--radius-round);
      background: #ffffff24;
      font-size: 0.875rem;
      text-transform: uppercase;
      font-weight: var(--primary-bold);
      letter-spacing: 0.06em;
    }
    .footer_booking_title {
      font-size: 1.6875rem;
      line-height: 1.08;
      margin-top: var(--space-3);
      font-weight: var(--primary-bold);
    }
    .footer_booking > img {
      position: absolute;
      width: 108%;
      max-width: none;
      height: 23.5625rem;
      object-fit: cover;
      left: -4%;
      bottom: 0;
    }
    .footer_info {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: var(--space-7);
      min-width: 0;
    }
    .footer_columns {
      display: grid;
      grid-template-columns: 1fr 1.2fr 1fr 1.25fr;
      gap: var(--space-4);
    }
    .footer_label {
      font-size: 0.875rem;
      line-height: 1.3;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: #ffffff99;
      margin-bottom: var(--space-3);
    }
    .footer_column ul {
      display: flex;
      flex-direction: column;
      gap: 1.875rem;
      font-size: 1.0625rem;
      line-height: 1.65;
    }
    .footer_link {
      transition: color 0.3s ease;
    }
    .footer_link:hover,
    .footer_link:focus-visible {
      color: var(--brand-500);
    }
    .footer_link.has-arrow {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
    .footer_link_arrow {
      width: 0.875rem;
      height: 0.875rem;
      flex: none;
      opacity: 0;
      translate: -0.375rem 0;
      transition: opacity 0.3s ease, translate 0.3s ease;
    }
    .footer_link.has-arrow:hover .footer_link_arrow,
    .footer_link.has-arrow:focus-visible .footer_link_arrow {
      opacity: 1;
      translate: 0 0;
    }
    @media (prefers-reduced-motion: reduce) {
      .footer_link_arrow { translate: 0 0; }
    }
    .footer_logo {
      width: 8.625rem;
      height: 4.4375rem;
      object-fit: contain;
      margin-bottom: var(--space-5);
    }
    .footer_contact {
      display: flex;
      flex-direction: column;
      gap: 1.875rem;
      font-style: normal;
      font-size: 0.875rem;
      line-height: 1.57;
      color: #ffffffcc;
      overflow-wrap: anywhere;
    }
    .footer_social {
      display: flex;
      gap: var(--space-3);
    }
    .footer_social_icon {
      display: block;
      width: 1.5rem;
      height: 1.5rem;
      background-color: currentcolor;
      mask: var(--_icon) center / contain no-repeat;
      transition: background-color 0.3s ease;
    }
    .footer_social_icon:hover {
      background-color: var(--brand-500);
    }
    .footer_bottom {
      border-top: var(--border-width) solid #ffffff24;
      padding-top: var(--space-7);
      margin-top: var(--space-7);
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: var(--space-4);
      font-size: 0.875rem;
      line-height: 1.57;
      color: #ffffff80;
    }
    .footer_legal {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-4);
    }
  }
</style>
