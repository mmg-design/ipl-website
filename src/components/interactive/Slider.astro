---
import type { HTMLAttributes } from "astro/types";
import Button from "@/components/Button.astro";
import { slotContent } from "@/utils/slots.ts";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Accessible label. Defaults to `Slider`. */
  label?: string;
  /** Slider bounds. `centered` bleeds, snaps slides to the middle and fades those toward the edges. */
  variant?: "bleed" | "crop-start" | "contained" | "centered";
  /** Show markers and arrows. */
  controls?: boolean;
  /** Loop endlessly. `centered` only. */
  loop?: boolean;
  /** Slides shown below 30rem. Defaults to `1.02`.
   *
   * @min 1
   * @max 12 */
  xsmall?: number;
  /** Slides shown from 30rem. Inherits `xsmall`.
   *
   * @min 1
   * @max 12 */
  small?: number;
  /** Slides shown from 48rem. Inherits `small`.
   *
   * @min 1
   * @max 12 */
  medium?: number;
  /** Slides shown from 64rem. Inherits `medium`.
   *
   * @min 1
   * @max 12 */
  large?: number;
};

const {
  render = true,
  label = "Slider",
  variant = "bleed",
  controls = true,
  loop = false,
  xsmall = 1.02,
  small,
  medium,
  large,
  class: className,
  ...rest
} = Astro.props;

const counts = { xs: xsmall, sm: small, md: medium, lg: large };

const invalid = Object.entries(counts).filter(
  ([, count]) => count !== undefined && !(Number.isFinite(count) && count > 0),
);

if (import.meta.env.DEV && invalid.length) {
  console.warn(
    `[lumos] <Slider> ignores ${invalid.map(([size]) => size).join(", ")}: slides in view must be greater than 0.`,
  );
}

const set = (count: number | undefined) =>
  count !== undefined && Number.isFinite(count) && count > 0;

const visible =
  [
    xsmall !== 1.02 && set(xsmall) && `--_visible-xs: ${xsmall}`,
    set(small) && `--_visible-sm: ${small}`,
    set(medium) && `--_visible-md: ${medium}`,
    set(large) && `--_visible-lg: ${large}`,
  ]
    .filter(Boolean)
    .join("; ") || undefined;

const slides = await slotContent(Astro.slots);
---

{
  render && slides && (
    <div
      class:list={["slider_wrap", variant !== "bleed" && variant, className]}
      style={visible}
      data-loop={loop && variant === "centered" ? "" : undefined}
      {...rest}
    >
      <div class="slider_list" role="group" aria-label={label} tabindex="0">
        <Fragment set:html={slides} />
      </div>

      <div class="slider_controls" hidden={!controls}>
        <div class="slider_markers" />
        <div class="slider_steps">
          <Button
            variant="arrow"
            emphasis="secondary"
            direction="back"
            label="Previous slide"
            data-step="-1"
          />
          <Button
            variant="arrow"
            emphasis="secondary"
            label="Next slide"
            data-step="1"
          />
        </div>
      </div>
    </div>
  )
}

<script>
  const THRESHOLD = 4;

  for (const slider of document.querySelectorAll<HTMLElement>(".slider_wrap")) {
    const list = slider.querySelector<HTMLElement>(".slider_list");
    const markers = slider.querySelector<HTMLElement>(".slider_markers");
    const controls = slider.querySelector<HTMLElement>(".slider_controls");
    const steps = [
      ...slider.querySelectorAll<HTMLButtonElement>("[data-step]"),
    ];
    if (!list) continue;

    const slides = [...list.children] as HTMLElement[];
    if (slides.length === 0) continue;

    slides.forEach((slide, i) => {
      slide.setAttribute("role", "group");
      slide.setAttribute("aria-label", `${i + 1} of ${slides.length}`);
    });

    const reduced = matchMedia("(prefers-reduced-motion: reduce)");
    const behavior = () => (reduced.matches ? "auto" : "smooth");

    const stride = () => {
      const first = slides[0].getBoundingClientRect();
      if (slides.length < 2) return first.width;
      return slides[1].getBoundingClientRect().left - first.left;
    };

    const view = () => {
      const box = getComputedStyle(list);
      return (
        list.clientWidth -
        parseFloat(box.paddingInlineStart) -
        parseFloat(box.paddingInlineEnd)
      );
    };

    const pages = () => {
      const step = stride();
      if (step <= 0) return 1;
      return Math.max(1, slides.length - Math.round(view() / step) + 1);
    };

    const current = () => {
      const step = stride();
      return step > 0 ? Math.round(list.scrollLeft / step) : 0;
    };

    let drawn = 0;

    const draw = (total: number) => {
      if (!markers) return;
      drawn = total;
      markers.replaceChildren(
        ...Array.from({ length: total }, (_, i) => {
          const marker = document.createElement("button");
          marker.type = "button";
          marker.className = "slider_marker";
          marker.setAttribute("aria-label", `Go to slide ${i + 1}`);
          marker.addEventListener("click", () =>
            list.scrollTo({ left: i * stride(), behavior: behavior() }),
          );
          return marker;
        }),
      );
    };

    const centered = slider.classList.contains("centered");
    const looping = centered && slider.dataset.loop !== undefined;

    /* Centered sliders loop by keeping an inert copy of the set on each side
       and jumping one set width whenever the view drifts into a copy. */
    if (looping) {
      const copy = () =>
        slides.map((slide) => {
          const clone = slide.cloneNode(true) as HTMLElement;
          clone.removeAttribute("aria-label");
          clone.setAttribute("aria-hidden", "true");
          clone.inert = true;
          clone.querySelectorAll("[id]").forEach((el) => el.removeAttribute("id"));
          clone.removeAttribute("id");
          return clone;
        });
      list.prepend(...copy(), ...copy());
      list.append(...copy(), ...copy());
    }
    const all = [...list.children] as HTMLElement[];
    if (looping) {
      list.querySelectorAll("img").forEach((img) => {
        img.loading = "eager";
        img.decoding = "async";
      });
    }
    const set = () => stride() * slides.length;
    if (looping) list.scrollLeft = set() * 2;

    /* Slides ride the top edge of a circle: offset from the middle sets how far
       each one drops and tilts, and how much it fades. */
    const focus = () => {
      const middle = list.scrollLeft + list.clientWidth / 2;
      const radius = Math.max(list.clientWidth * 6, 1800);
      const step = stride() || 1;
      for (const slide of all) {
        const offset = slide.offsetLeft + slide.offsetWidth / 2 - middle;
        const limit = step * 2.5;
        const x = Math.max(-limit, Math.min(limit, offset));
        const drop = radius - Math.sqrt(radius * radius - x * x);
        const tilt = (Math.asin(x / radius) * 180) / Math.PI;
        const fade = Math.min(1, Math.abs(offset) / (step * 1.5));
        slide.style.setProperty("--_arch-y", `${drop.toFixed(2)}px`);
        slide.style.setProperty("--_arch-tilt", `${tilt.toFixed(3)}deg`);
        slide.style.setProperty("--_focus", (1 - fade * 0.55).toFixed(3));
      }
    };

    const wrap = () => {
      if (!looping) return;
      const width = set();
      if (width <= 0) return;
      let shift = 0;
      if (list.scrollLeft < width * 1.5) shift = width;
      else if (list.scrollLeft > width * 2.5) shift = -width;
      if (!shift) return;
      list.scrollLeft += shift;
      from += shift;
    };

    let settle = 0;
    const sync = () => {
      if (looping) {
        clearTimeout(settle);
        settle = window.setTimeout(() => {
          if (!pressed) wrap();
          focus();
        }, 160);
      }
      if (centered) focus();
      if (looping) return;
      const total = pages();
      if (total !== drawn) draw(total);

      const end = list.scrollWidth - list.clientWidth;
      const atStart = list.scrollLeft <= 1;
      const atEnd = list.scrollLeft >= end - 1;

      for (const step of steps) {
        step.disabled = Number(step.dataset.step) < 0 ? atStart : atEnd;
      }

      const index = current();
      markers?.querySelectorAll(".slider_marker").forEach((marker, i) => {
        marker.classList.toggle("is-active", i === index);
        if (i === index) marker.setAttribute("aria-current", "true");
        else marker.removeAttribute("aria-current");
      });

      controls?.classList.toggle("is-empty", end <= 1);
    };

    for (const step of steps) {
      step.addEventListener("click", () =>
        list.scrollBy({
          left: Number(step.dataset.step) * stride(),
          behavior: behavior(),
        }),
      );
    }

    let origin = 0;
    let from = 0;
    let pressed = false;
    let dragged = false;

    const restore = () => {
      if (!pressed) list.classList.remove("is-dragging");
    };

    list.addEventListener("pointerdown", (event) => {
      if (event.pointerType !== "mouse" || event.button !== 0) return;
      if (list.scrollWidth <= list.clientWidth) return;
      pressed = true;
      dragged = false;
      origin = event.clientX;
      from = list.scrollLeft;
    });

    list.addEventListener("pointermove", (event) => {
      if (!pressed) return;
      const shift = event.clientX - origin;
      if (!dragged) {
        if (Math.abs(shift) < THRESHOLD) return;
        dragged = true;
        list.setPointerCapture(event.pointerId);
        list.classList.add("is-dragging");
      }
      list.scrollLeft = from - shift;
    });

    const release = () => {
      if (!pressed) return;
      pressed = false;
      const step = stride();
      if (dragged && step > 0) {
        list.scrollTo({
          left: Math.round(list.scrollLeft / step) * step,
          behavior: behavior(),
        });
      }
      list.addEventListener("scrollend", restore, { once: true });
      setTimeout(restore, 400);
    };

    list.addEventListener("pointerup", release);
    list.addEventListener("pointercancel", release);
    list.addEventListener("dragstart", (event) => event.preventDefault());

    list.addEventListener(
      "click",
      (event) => {
        if (!dragged) return;
        event.preventDefault();
        event.stopPropagation();
      },
      true,
    );

    let frame = 0;
    list.addEventListener(
      "scroll",
      () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(sync);
      },
      { passive: true },
    );

    slider.classList.add("is-ready");

    const resize = new ResizeObserver(sync);
    resize.observe(list);

    addEventListener("load", sync);
    sync();
  }
</script>

<style is:global>
  @layer components {
    .slider_wrap {
      --_gap-size: var(--site-gutter);
      --_edge: max(var(--site-margin), (100vw - var(--max-width-main)) / 2);
      --_visible: var(--_visible-xs);
      --_visible-xs: 1.02;
      --_visible-sm: var(--_visible-xs);
      --_visible-md: var(--_visible-sm);
      --_visible-lg: var(--_visible-md);
      display: grid;
      gap: var(--space-6);
      width: 100%;

      @media (width >= 30rem) {
        --_visible: var(--_visible-sm);
      }
      @media (width >= 48rem) {
        --_visible: var(--_visible-md);
      }
      @media (width >= 64rem) {
        --_visible: var(--_visible-lg);
      }
    }

    .slider_list {
      display: flex;
      gap: var(--_gap-size);
      min-width: 0;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      cursor: grab;
      margin-inline: calc(-1 * var(--_edge));
      padding-inline: var(--_edge);
      scroll-padding-inline: var(--_edge);

      &::-webkit-scrollbar {
        display: none;
      }

      &:active {
        cursor: grabbing;
      }

      &.is-dragging {
        scroll-snap-type: none;
        -webkit-user-select: none;
        user-select: none;
      }

      .slider_wrap:not(.is-ready) &,
      .slider_wrap:has(.slider_controls.is-empty) & {
        cursor: auto;
      }

      & > * {
        flex: 0 0
          calc(
            (100% - (var(--_visible) - 1) * var(--_gap-size)) / var(--_visible)
          );
        min-width: 0;
        scroll-snap-align: start;
      }

      .slider_wrap.crop-start & {
        margin-inline-start: 0;
        padding-inline-start: 0;
        scroll-padding-inline-start: 0;
      }

      .slider_wrap.centered & {
        position: relative;
        overflow-y: hidden;
        overscroll-behavior-y: auto;
        scroll-snap-type: x proximity;
        padding-block: var(--space-2) var(--space-8);
      }

      .slider_wrap.centered & > * {
        scroll-snap-align: center;
        opacity: var(--_focus, 1);
        transform: translateY(var(--_arch-y, 0)) rotate(var(--_arch-tilt, 0deg));
        transform-origin: 50% 100%;
        will-change: transform, opacity;
        backface-visibility: hidden;
      }

      .slider_wrap.contained & {
        margin-inline: 0;
        padding-inline: 0;
        scroll-padding-inline: 0;
      }
    }

    .slider_controls {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);

      .slider_wrap:not(.is-ready) &,
      &.is-empty,
      &[hidden] {
        display: none;
      }
    }

    .slider_markers {
      display: flex;
      align-items: center;
      gap: var(--space-2);
    }

    .slider_marker {
      width: 0.75rem;
      height: 0.75rem;
      padding: 0;
      border: var(--border-width) solid var(--text);
      border-radius: var(--radius-round);
      background: none;
      transition: background-color var(--hover-duration) var(--hover-ease);

      &.is-active {
        background-color: var(--text);
      }
      @media (hover: hover) {
        &:hover {
          background-color: var(--text);
        }
      }
    }

    .slider_steps {
      display: flex;
      gap: var(--space-2);
    }
  }
</style>
