---
/**
 * One portrait clip at a time. When a clip finishes, it slides out and the next
 * slides in. A segmented bar on top shows where you are in the set. Loads one clip
 * ahead, pauses off screen, and holds on the first poster for reduced motion.
 */
import type { Clip } from "@/data/media";
interface Props { clips: Clip[]; class?: string }
const { clips, class: className } = Astro.props;
---

<div class:list={["clip-cycler", className]} data-clip-cycler aria-hidden="true">
  <div class="clip-cycler_progress">
    {clips.map(() => <span class="clip-cycler_segment"><span class="clip-cycler_fill"></span></span>)}
  </div>
  {clips.map((c, i) => (
    <video
      class:list={["clip-cycler_video", i === 0 && "is-active"]}
      data-src={c.src}
      data-label={c.label}
      poster={c.poster}
      muted
      playsinline
      preload="none"
    ></video>
  ))}
  <span class="clip-cycler_label">{clips[0]?.label}</span>
</div>

<script>
  const reduced = matchMedia("(prefers-reduced-motion: reduce)");
  const MIN_SHOW = 3.5; // seconds: short clips repeat until they have been on screen this long

  for (const root of document.querySelectorAll<HTMLElement>("[data-clip-cycler]")) {
    const videos = [...root.querySelectorAll<HTMLVideoElement>("video")];
    const fills = [...root.querySelectorAll<HTMLElement>(".clip-cycler_fill")];
    const label = root.querySelector<HTMLElement>(".clip-cycler_label");
    if (!videos.length) continue;
    let index = 0, plays = 0, visible = false, failed = 0;

    const load = (v: HTMLVideoElement) => { if (!v.src && v.dataset.src) { v.src = v.dataset.src; v.load(); } };
    const repeats = (v: HTMLVideoElement) => (v.duration ? Math.max(1, Math.ceil(MIN_SHOW / v.duration)) : 1);
    const play = () => { if (visible && !reduced.matches) videos[index].play().catch(() => {}); };

    const advance = () => {
      const current = videos[index];
      const nextIndex = (index + 1) % videos.length;
      const next = videos[nextIndex];
      load(next); load(videos[(nextIndex + 1) % videos.length]);
      next.currentTime = 0;
      current.classList.remove("is-active"); current.classList.add("is-leaving");
      next.classList.add("is-active");
      setTimeout(() => { current.classList.remove("is-leaving"); current.pause(); }, 800);
      if (nextIndex === 0) fills.forEach((f) => (f.style.width = "0%"));
      else fills[index].style.width = "100%";
      if (label) {
        label.classList.add("is-swapping");
        setTimeout(() => { label.textContent = next.dataset.label ?? ""; label.classList.remove("is-swapping"); }, 350);
      }
      index = nextIndex; plays = 0;
      play();
    };

    videos.forEach((v, i) => {
      v.addEventListener("timeupdate", () => {
        if (i !== index || !v.duration) return;
        const done = (plays * v.duration + v.currentTime) / (repeats(v) * v.duration);
        fills[i].style.width = `${Math.min(100, done * 100)}%`;
      });
      v.addEventListener("ended", () => {
        plays += 1;
        if (plays < repeats(v)) { v.currentTime = 0; play(); } else advance();
      });
      v.addEventListener("playing", () => { failed = 0; });
      // A clip that fails is skipped; if every clip fails, stop on the current poster.
      v.addEventListener("error", () => { failed += 1; if (i === index && failed < videos.length) advance(); });
    });

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible) { load(videos[index]); load(videos[(index + 1) % videos.length]); play(); }
      else videos[index].pause();
    }, { rootMargin: "100px 0px" }).observe(root);
  }
</script>

<style is:global>
  @layer components {
    .clip-cycler { position: relative; overflow: hidden; aspect-ratio: 9 / 16; background: var(--dark-950); isolation: isolate; }
    .clip-cycler_video {
      position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
      translate: 100% 0; scale: 0.96; opacity: 0;
      transition: translate 0.8s cubic-bezier(0.65, 0, 0.35, 1), scale 0.8s cubic-bezier(0.65, 0, 0.35, 1), opacity 0.5s ease;
    }
    .clip-cycler_video.is-active { translate: 0 0; scale: 1; opacity: 1; z-index: 1; }
    .clip-cycler_video.is-leaving { translate: -30% 0; scale: 0.94; opacity: 0; }
    .clip-cycler_progress { position: absolute; z-index: 3; inset: 0.875rem 0.875rem auto; display: flex; gap: 0.3rem; }
    .clip-cycler_segment { flex: 1; height: 3px; border-radius: 2px; background: rgb(255 255 255 / 0.28); overflow: hidden; }
    .clip-cycler_fill { display: block; width: 0%; height: 100%; background: white; transition: width 0.25s linear; }
    .clip-cycler_label {
      position: absolute; left: 1rem; bottom: 1rem; z-index: 3;
      padding: 0.375rem 0.75rem; border-radius: 999px; color: white;
      font-size: 0.75rem; font-weight: var(--primary-bold); letter-spacing: 0.08em; text-transform: uppercase;
      background: rgb(1 26 41 / 0.6); backdrop-filter: blur(6px); border: 1px solid rgb(255 255 255 / 0.18);
      transition: opacity 0.35s ease, translate 0.35s ease;
    }
    .clip-cycler_label.is-swapping { opacity: 0; translate: 0 0.375rem; }
    @media (prefers-reduced-motion: reduce) {
      .clip-cycler_video, .clip-cycler_label { transition: none; }
      .clip-cycler_progress { display: none; }
    }
  }
</style>
