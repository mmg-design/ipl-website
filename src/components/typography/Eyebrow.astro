---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** HTML element. */
  tag?: "span" | "p" | "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Eyebrow style. */
  variant?: "default" | "tag";
};

const {
  render = true,
  tag: Tag = "p",
  variant = "tag",
  class: className,
  ...rest
} = Astro.props;

const content = await slotContent(Astro.slots);
/* "Topic · Location" eyebrows: the suffix gets its own span so a hero can drop it on phones (see FeatureHero). */
const sep = " · ";
const [lead, ...tail] = typeof content === "string" ? content.split(sep) : [content];
const suffix = tail.length ? sep + tail.join(sep) : "";
---

{
  render && content && (
    <div
      class:list={["eyebrow_wrap", variant !== "default" && variant, className]}
      {...rest}
    >
      {variant === "default" && (
        <span class="eyebrow_marker" aria-hidden="true" />
      )}
      <Tag class="eyebrow_text text-style-small">
        <Fragment set:html={lead} />
        {suffix && <span class="eyebrow_suffix" set:html={suffix} />}
      </Tag>
    </div>
  )
}

<style is:global>
  @layer components {
    .eyebrow_wrap {
      display: inline-flex;
      align-items: center;
      justify-content: var(--_alignment, start);
      gap: var(--space-2);

      &.tag {
        min-height: 2rem;
        background-color: color-mix(in srgb, currentcolor 10%, transparent);
        border: var(--border-width) solid
          color-mix(in srgb, currentcolor 24%, transparent);
        color: inherit;
        padding: 0.375rem 0.875rem;
        border-radius: var(--radius-round);
      }
      .eyebrow_text {
        font-size: 0.875rem;
        font-weight: var(--primary-bold);
        letter-spacing: 0.06em;
        line-height: 1.3;
        text-transform: uppercase;
      }
      /* Phones: the pill always stays on one line, the type scales down with the screen instead */
      @media (width < 48rem) {
        &.tag { padding: 0.3125rem 0.75rem; max-width: 100%; }
        .eyebrow_text { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: clamp(0.625rem, 2.85vw, 0.8125rem); letter-spacing: 0.04em; }
      }
      .eyebrow_marker {
        flex: none;
        width: var(--border-width);
        height: 0.75rem;
        background-color: currentcolor;
      }
    }
  }
</style>
