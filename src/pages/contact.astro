---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import Scene from "@/components/media/Scene.astro";
import FaqSection from "@/components/content/FaqSection.astro";
import HeroContact from "@/components/content/HeroContact.astro";
import TestimonialWall from "@/components/content/TestimonialWall.astro";
import CtaMain from "@/components/content/CtaMain.astro";
import { contactFaqs } from "@/data/contact";
---

<Layout theme="dark" overlap title="Contact Inge Performance Lab">
  <!-- Hero + form -->
  <Section theme="dark" paddingTop="none" paddingBottom="none" class="contact-hero_section" aria-label="Contact Inge Performance Lab">
    <div slot="background" class="contact-hero_bg" aria-hidden="true">
      <img src="/images/contact-hero-bg.webp" alt="" />
    </div>
    <HeroContact />
  </Section>

  <!-- Reviews carousel (Senja) -->
  <Section theme="light" class="contact-reviews_section" aria-label="Google reviews">
    <TestimonialWall id="08367aee-889b-432d-8e39-c1c346e49f23" />
  </Section>

  <!-- FAQs -->
  <Section id="faqs" theme="light" paddingTop="none" aria-labelledby="faqs-title">
    <FaqSection heading="Questions we get asked most." items={contactFaqs} />
  </Section>

  <Section id="contact" paddingTop="none" paddingBottom="none" aria-label="Book at Inge Performance Lab">
    <Scene slot="background" variant="cta" />
    <CtaMain />
  </Section>
</Layout>

<style is:global>
  @layer components {
    .contact-hero_section { min-height: 0; background-color: #022337; }
    .contact-hero_bg { position: absolute; inset: 0; overflow: hidden; }
    .contact-hero_bg img { width: 100%; height: 100%; object-fit: cover; opacity: 0.71; }
    .contact-hero_bg::after { content: ""; position: absolute; inset: 0; background: rgb(2 35 55 / 0.62); }
    .contact-reviews_section { min-height: 0; }
    #faqs { min-height: 0; }
  }
</style>
