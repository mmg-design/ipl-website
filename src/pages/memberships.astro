---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import Scene from "@/components/media/Scene.astro";
import FeatureHero from "@/components/content/FeatureHero.astro";
import PricingTiers from "@/components/content/PricingTiers.astro";
import IncludedGrid from "@/components/content/IncludedGrid.astro";
import SplitFeature from "@/components/content/SplitFeature.astro";
import FaqSection from "@/components/content/FaqSection.astro";
import TestimonialsSection from "@/components/content/TestimonialsSection.astro";
import CtaMain from "@/components/content/CtaMain.astro";
import { hero, cagePlans, elitePlans, included, den, faqs } from "@/data/memberships";
---

<Layout theme="dark" overlap title="Batting Cage and Training Memberships in Brighton, MI">
  <Section theme="dark" paddingTop="none" paddingBottom="none" class="feature-hero_section" aria-label="Memberships">
    <div slot="background" class="feature-hero_bg" aria-hidden="true">
      <img src={hero.image} alt="" />
    </div>
    <FeatureHero {...hero} />
  </Section>

  <Section id="plans" theme="light" class="feature_section" aria-labelledby="plans-title">
    <PricingTiers {...cagePlans} />
  </Section>

  <Section id="elite" theme="dark" class="feature_section feature_section-glow" aria-labelledby="elite-title">
    <PricingTiers {...elitePlans} />
  </Section>

  <Section id="included" theme="light" class="feature_section" aria-label="What members get">
    <IncludedGrid {...included} />
  </Section>

  <Section id="den" theme="dark" class="feature_section feature_section-glow" aria-label="The Den programs">
    <SplitFeature {...den} />
  </Section>

  <Section id="faqs" theme="light" class="feature_section" aria-labelledby="faqs-title">
    <FaqSection heading={faqs.heading} text={faqs.text} items={faqs.items} contactPrompt />
  </Section>

  <Section id="testimonials" theme="light" class="feature_section feature_section-fade" aria-labelledby="testimonials-title">
    <TestimonialsSection />
  </Section>

  <Section id="contact" paddingTop="none" paddingBottom="none" aria-label="Join Inge Performance Lab">
    <Scene slot="background" variant="cta" />
    <CtaMain />
  </Section>
</Layout>
