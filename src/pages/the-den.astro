---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import Scene from "@/components/media/Scene.astro";
import FeatureHero from "@/components/content/FeatureHero.astro";
import WaysGrid from "@/components/content/WaysGrid.astro";
import SplitFeature from "@/components/content/SplitFeature.astro";
import ClipReel from "@/components/content/ClipReel.astro";
import FaqSection from "@/components/content/FaqSection.astro";
import PricingTiers from "@/components/content/PricingTiers.astro";
import TestimonialsSection from "@/components/content/TestimonialsSection.astro";
import BlogTeaser from "@/components/content/BlogTeaser.astro";
import CtaMain from "@/components/content/CtaMain.astro";
import Button from "@/components/Button.astro";
import FreeAssessment from "@/components/content/FreeAssessment.astro";
import { hero, memberships, room, twoSP, clips, faqs } from "@/data/the-den";
---

<Layout theme="dark" overlap title="The Den: Baseball and Softball Strength Training in Michigan">
  <Section theme="dark" paddingTop="none" paddingBottom="none" class="feature-hero_section is-split" aria-label="The Den strength training">
    <Scene slot="background" variant="wall" />
    <FeatureHero {...hero} />
  </Section>

  <Section id="memberships" theme="light" class="feature_section" aria-labelledby="memberships-title">
    <PricingTiers {...memberships} />
    <div class="den-memberships_actions">
      {memberships.actions.map((a) => <Button element="link" href={a.href} emphasis={a.emphasis}>{a.label}</Button>)}
    </div>
  </Section>

  <Section id="clips" theme="dark" class="feature_section" aria-label="Inside The Den">
    <ClipReel {...clips} />
  </Section>

  <Section id="room" theme="light" class="feature_section feature_section-fade" aria-label="The room">
    <SplitFeature {...room} glow={false} />
  </Section>

  <Section id="2sp" theme="dark" class="feature_section feature_section-glow" aria-label="About 2SP">
    <SplitFeature {...twoSP} headingVariant="h3" />
  </Section>

  <Section id="faqs" theme="light" class="feature_section" aria-labelledby="faqs-title">
    <FaqSection heading={faqs.heading} text={faqs.text} items={faqs.items} contactPrompt />
  </Section>

  <Section id="testimonials" theme="light" class="feature_section feature_section-fade" aria-labelledby="testimonials-title">
    <TestimonialsSection />
  </Section>

  <Section id="blog" theme="dark" class="feature_section" aria-labelledby="blog-title">
    <BlogTeaser page="the-den" />
  </Section>

  <Section id="contact" paddingTop="none" paddingBottom="none" aria-label="Book at Inge Performance Lab">
    <Scene slot="background" variant="cta" />
    <CtaMain />
  </Section>

  <FreeAssessment />
</Layout>

<style is:global>
  @layer components {
    .den-memberships_actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem; margin-top: var(--space-8); }
  }
</style>
