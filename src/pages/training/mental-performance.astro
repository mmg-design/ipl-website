---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import Scene from "@/components/media/Scene.astro";
import FeatureHero from "@/components/content/FeatureHero.astro";
import WaysGrid from "@/components/content/WaysGrid.astro";
import SplitFeature from "@/components/content/SplitFeature.astro";
import FaqSection from "@/components/content/FaqSection.astro";
import TestimonialsSection from "@/components/content/TestimonialsSection.astro";
import TrainingLinks from "@/components/content/TrainingLinks.astro";
import BlogTeaser from "@/components/content/BlogTeaser.astro";
import CtaMain from "@/components/content/CtaMain.astro";
import { hero, skills, audience, partner, faqs } from "@/data/mental-performance";
---

<Layout theme="dark" overlap title="Mental Performance Coaching for Athletes in Brighton, MI">
  <Section theme="dark" paddingTop="none" paddingBottom="none" class="feature-hero_section is-inset" aria-label="Mental performance coaching">
    <div slot="background" class="feature-hero_bg is-light is-dim is-right" aria-hidden="true">
      <img src={hero.image} alt="" />
    </div>
    <FeatureHero {...hero} ticker />
  </Section>

  <Section id="skills" theme="light" class="feature_section" aria-label="What gets worked on">
    <WaysGrid {...skills} variant="stack" />
  </Section>

  <Section id="who" theme="light" class="feature_section feature_section-fade" aria-label="Who it's for">
    <SplitFeature {...audience} glow={false} />
  </Section>

  <Section id="partner" theme="dark" class="feature_section feature_section-glow" aria-label="Champion Mindset Group">
    <SplitFeature {...partner} />
  </Section>

  <Section id="faqs" theme="light" class="feature_section" aria-labelledby="faqs-title">
    <FaqSection heading={faqs.heading} text={faqs.text} items={faqs.items} contactPrompt />
  </Section>

  <Section id="testimonials" theme="light" class="feature_section feature_section-fade" aria-labelledby="testimonials-title">
    <TestimonialsSection />
  </Section>

  <Section id="more-training" theme="light" class="feature_section" aria-label="Other training at IPL">
    <TrainingLinks current="mental-performance" />
  </Section>

  <Section id="blog" theme="dark" class="feature_section" aria-labelledby="blog-title">
    <BlogTeaser page="mental-performance" />
  </Section>

  <Section id="contact" paddingTop="none" paddingBottom="none" aria-label="Book at Inge Performance Lab">
    <Scene slot="background" variant="cta" />
    <CtaMain />
  </Section>
</Layout>
