---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import Scene from "@/components/media/Scene.astro";
import FeatureHero from "@/components/content/FeatureHero.astro";
import WaysGrid from "@/components/content/WaysGrid.astro";
import SplitFeature from "@/components/content/SplitFeature.astro";
import PricingTiers from "@/components/content/PricingTiers.astro";
import FaqSection from "@/components/content/FaqSection.astro";
import TestimonialsSection from "@/components/content/TestimonialsSection.astro";
import BlogTeaser from "@/components/content/BlogTeaser.astro";
import CtaMain from "@/components/content/CtaMain.astro";
import TrainingLinks from "@/components/content/TrainingLinks.astro";
import { hero, approach, model, tools, pricing, faqs } from "@/data/pitching";
---

<Layout theme="dark" overlap title="Pitching Lessons and Training in Brighton, MI">
  <Section theme="dark" paddingTop="none" paddingBottom="none" class="feature-hero_section is-inset" aria-label="Pitching lessons and training">
    <div slot="background" class="feature-hero_bg is-light" aria-hidden="true">
      <img src={hero.image} alt="" />
    </div>
    <FeatureHero {...hero} ticker />
  </Section>

  <Section id="approach" theme="light" class="feature_section" aria-label="The approach">
    <WaysGrid {...approach} variant="panels" />
  </Section>

  <Section id="model" theme="light" class="feature_section feature_section-fade" aria-label="The model">
    <SplitFeature {...model} glow={false} />
  </Section>

  <Section id="tools" theme="dark" class="feature_section feature_section-glow" aria-label="Measured progress">
    <SplitFeature {...tools} headingVariant="h3" />
  </Section>

  <Section id="rates" theme="light" class="feature_section" aria-labelledby="pricing-title">
    <PricingTiers {...pricing} />
  </Section>

  <Section id="faqs" theme="light" class="feature_section feature_section-fade" aria-labelledby="faqs-title">
    <FaqSection heading={faqs.heading} text={faqs.text} items={faqs.items} contactPrompt />
  </Section>

  <Section id="testimonials" theme="light" class="feature_section" aria-labelledby="testimonials-title">
    <TestimonialsSection />
  </Section>

  <Section id="more-training" theme="light" class="feature_section feature_section-fade" aria-label="Other training at IPL">
    <TrainingLinks current="pitching" />
  </Section>

  <Section id="blog" theme="dark" class="feature_section" aria-labelledby="blog-title">
    <BlogTeaser page="pitching" />
  </Section>

  <Section id="contact" paddingTop="none" paddingBottom="none" aria-label="Book at Inge Performance Lab">
    <Scene slot="background" variant="cta" />
    <CtaMain />
  </Section>
</Layout>
