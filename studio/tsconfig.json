{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "jsx": "preserve",
    "strict": false, "skipLibCheck": true, "esModuleInterop": true, "resolveJsonModule": true, "isolatedModules": true, "noEmit": true
  },
  "include": ["**/*.ts", "**/*.tsx", "../sanity/schemas/*.ts"],
  "exclude": ["node_modules", "dist"]
}
